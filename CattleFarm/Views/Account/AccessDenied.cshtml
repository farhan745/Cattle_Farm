@{
    ViewData["Title"] = "Access Denied";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string homeUrl = role switch
    {
        "Admin" or "Owner" => "/Dashboard",
        "Manager" => "/FarmJoin/ManagerBrowse",
        "Worker" => "/FarmJoin/Browse",
        "Doctor" => "/Dashboard",
        _ => "/"
    };
    string homeLabel = role switch
    {
        "Manager" => "Find a Farm",
        "Worker" => "Browse Farms",
        _ => "Dashboard"
    };
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-danger shadow-sm">
            <div class="card-body py-5">
                <div style="font-size: 4rem;"></div>
                <h2 class="card-title text-danger mt-3">Access Denied</h2>
                <p class="card-text text-muted">
                    You don't have permission to view this page.<br />
                    If you believe this is a mistake, go back to your dashboard or contact an administrator.
                </p>
                <hr />
                <a href="@homeUrl" class="btn btn-primary me-2">
                    <i class="bi bi-house"></i> @homeLabel
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
