@model CattleFarm.ViewModels.FarmJoinApplyViewModel
@{
    var isManager = string.Equals(ViewBag.JoinMode as string, "Manager", StringComparison.OrdinalIgnoreCase);
    var browseUrl = isManager ? "/FarmJoin/ManagerBrowse" : "/FarmJoin/Browse";
    var applyAction = isManager ? "ManagerApply" : "Apply";
    ViewData["Title"] = isManager ? "Apply as Manager" : "Apply to Farm";
}

<div class="page-header">
    <div><h1 class="page-title">@(isManager ? "Apply as Manager" : "Apply to Farm")</h1></div>
    <a href="@browseUrl" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="max-width:520px;margin:0 auto">
    <div class="card" style="padding:28px">
        <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-bottom:24px;display:flex;gap:12px;align-items:center">
            <span style="font-size:28px"></span>
            <div>
                <div style="font-weight:700;font-size:15px">@Model.FarmName</div>
                <div style="font-size:12px;color:var(--text-muted)">
                    @(isManager ? "Request to manage this farm" : "Request to join this farm as a worker")
                </div>
            </div>
        </div>

        <form asp-action="@applyAction" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FarmId" />
            <input type="hidden" asp-for="FarmName" />

            <div style="margin-bottom:24px">
                <label style="font-weight:600;display:block;margin-bottom:6px;font-size:13.5px">
                    Message to owner (optional)
                </label>
                <textarea asp-for="Message" rows="4"
                    style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font-family:inherit;font-size:14px;outline:none;resize:vertical"
                    placeholder="Briefly describe your experience and why you want to join this farm..."></textarea>
            </div>

            <div style="display:flex;justify-content:end;gap:12px;border-top:1px solid var(--border);padding-top:20px">
                <a href="@browseUrl" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i> Submit Application
                </button>
            </div>
        </form>
    </div>
</div>
