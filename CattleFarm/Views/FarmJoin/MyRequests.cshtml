@model IEnumerable<CattleFarm.ViewModels.MyJoinRequestViewModel>
@{
    var isManager = string.Equals(ViewBag.JoinMode as string, "Manager", StringComparison.OrdinalIgnoreCase);
    var browseUrl = isManager ? "/FarmJoin/ManagerBrowse" : "/FarmJoin/Browse";
    ViewData["Title"] = "My Applications";
}

<div class="page-header">
    <div><h1 class="page-title">My Applications</h1></div>
    <a href="@browseUrl" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (!Model.Any())
{
    <div style="text-align:center;padding:64px 20px;color:var(--text-muted)">
        <div style="font-size:48px;margin-bottom:12px"></div>
        <div style="font-weight:700">No applications yet</div>
        <a href="@browseUrl" class="btn btn-primary" style="margin-top:16px">Browse Farms</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Farm</th>
                        <th>Status</th>
                        <th>Applied</th>
                        <th>Reviewed</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var badge = r.Status switch
                        {
                            "Accepted" => "badge-success",
                            "Rejected" => "badge-danger",
                            "Applied" or "Pending" => "badge-warning",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td style="font-weight:600">@r.FarmName</td>
                            <td><span class="badge @badge">@r.Status</span></td>
                            <td style="font-size:12px">@r.AppliedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                            <td style="font-size:12px">@(r.ReviewedAt.HasValue ? r.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, yyyy") : "—")</td>
                            <td style="font-size:12px">
                                @if (r.Status == "Rejected" && r.CooldownEnds.HasValue && r.CooldownEnds > DateTime.UtcNow)
                                {
                                    <span class="text-muted">
                                        <i class="bi bi-clock"></i> Cooldown until @r.CooldownEnds.Value.ToLocalTime().ToString("MMM dd")
                                    </span>
                                }
                                else
                                {
                                    @(r.ReviewNote ?? "—")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
