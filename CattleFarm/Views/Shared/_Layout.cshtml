<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Smart Cattle Farm</title>
    <meta name="description" content="Smart Cattle Farm Management System — livestock tracking, health records, milk production, and farm analytics." />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#14532d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-components-extended.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var userDisplayName = User.FindFirst("FullName")?.Value;
        if (string.IsNullOrWhiteSpace(userDisplayName))
            userDisplayName = User.Identity?.Name ?? "User";
        var userInitials = CattleFarm.Authorization.UserClaimsHelper.GetInitials(userDisplayName);
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

        <div class="app-shell">
            <!-- SIDEBAR -->
            <nav class="sidebar" id="sidebar">
                <!-- Brand -->
                <div class="sidebar-brand">
                    <div class="brand-icon">
                        <i class="bi bi-houses"></i>
                    </div>
                    <div class="collapse-label">
                        <div class="brand-name">Smart Cattle Farm</div>
                        <div class="brand-sub">Management System</div>
                    </div>
                    <button class="sidebar-collapse-btn" onclick="toggleSidebar()" title="Collapse sidebar" aria-label="Toggle sidebar">
                        <i class="bi bi-layout-sidebar-reverse" id="collapseIcon"></i>
                    </button>
                </div>

                <!-- Navigation -->
                <div class="sidebar-nav">
                    <div class="nav-section">Overview</div>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/Dashboard">
                        <i class="bi bi-grid-1x2 nav-icon"></i><span class="nav-text">Dashboard</span>
                    </a>
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Owner") && !User.IsInRole("Manager") && !User.IsInRole("Doctor") && !User.IsInRole("Worker"))
                    {
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" ? "active" : "")" href="/Doctor">
                            <i class="bi bi-person-badge nav-icon"></i><span class="nav-text">Veterinarians</span>
                        </a>
                    }

                    @if (User.IsInRole("Manager"))
                    {
                        <div class="nav-section">My Farm Job</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "FarmJoin" ? "active" : "")" href="/FarmJoin/ManagerBrowse">
                            <i class="bi bi-search nav-icon"></i><span class="nav-text">Find a Farm</span>
                        </a>
                        <a class="nav-item" href="/FarmJoin/ManagerRequests">
                            <i class="bi bi-envelope nav-icon"></i><span class="nav-text">My Applications</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager"))
                    {
                        <div class="nav-section">Farm Management</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Farm" ? "active" : "")" href="/Farm">
                            <i class="bi bi-house-door nav-icon"></i><span class="nav-text">Farms</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cattle" ? "active" : "")" href="/Cattle">
                            <i class="bi bi-geo-alt nav-icon"></i><span class="nav-text">Cattle</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Worker" ? "active" : "")" href="/Worker">
                            <i class="bi bi-people nav-icon"></i><span class="nav-text">Workers</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "MilkProduction" ? "active" : "")" href="/MilkProduction">
                            <i class="bi bi-droplet nav-icon"></i><span class="nav-text">Milk Production</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Breeding" ? "active" : "")" href="/Breeding">
                            <i class="bi bi-diagram-2 nav-icon"></i><span class="nav-text">Breeding</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Feed" ? "active" : "")" href="/Feed">
                            <i class="bi bi-box2 nav-icon"></i><span class="nav-text">Feed Management</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SmartMonitoring" ? "active" : "")" href="/SmartMonitoring">
                            <i class="bi bi-broadcast-pin nav-icon"></i><span class="nav-text">Smart Monitor</span>
                        </a>
                        
                        <div class="nav-section">Staff Operations</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" href="/Attendance">
                            <i class="bi bi-calendar-check nav-icon"></i><span class="nav-text">Attendance</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaskAssignment" ? "active" : "")" href="/TaskAssignment">
                            <i class="bi bi-check2-square nav-icon"></i><span class="nav-text">Task Board</span>
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                        {
                            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payroll" ? "active" : "")" href="/Payroll">
                                <i class="bi bi-credit-card-2-front nav-icon"></i><span class="nav-text">Payroll</span>
                            </a>
                        }
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Doctor") || User.IsInRole("Worker"))
                    {
                        <div class="nav-section">Health &amp; Vets</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Health" ? "active" : "")" href="/Health">
                            <i class="bi bi-heart-pulse nav-icon"></i><span class="nav-text">Health Records</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" ? "active" : "")" href="/Doctor">
                            <i class="bi bi-person-badge nav-icon"></i><span class="nav-text">Veterinarians</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointment" ? "active" : "")" href="/Appointment">
                            <i class="bi bi-calendar-check nav-icon"></i><span class="nav-text">Appointments</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                    {
                        <div class="nav-section">Commerce</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")" href="/Product">
                            <i class="bi bi-box-seam nav-icon"></i><span class="nav-text">Products</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")" href="/Order">
                            <i class="bi bi-receipt nav-icon"></i><span class="nav-text">Orders</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cattle" && ViewContext.RouteData.Values["action"]?.ToString() == "Marketplace" ? "active" : "")" href="/Cattle/Marketplace">
                            <i class="bi bi-shop nav-icon"></i><span class="nav-text">Marketplace</span>
                        </a>
                    }

                    @* Customer gets a simple Shop & Orders section *@
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Owner") && !User.IsInRole("Manager") && !User.IsInRole("Worker") && !User.IsInRole("Doctor"))
                    {
                        <div class="nav-section">Shop</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")" href="/Product">
                            <i class="bi bi-shop nav-icon"></i><span class="nav-text">Browse Products</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")" href="/Order">
                            <i class="bi bi-receipt nav-icon"></i><span class="nav-text">My Orders</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                    {
                        <div class="nav-section">Transport</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="/Transport">
                            <i class="bi bi-truck nav-icon"></i><span class="nav-text">Transport Hub</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Vehicles" ? "active" : "")" href="/Transport/Vehicles">
                            <i class="bi bi-truck-front nav-icon"></i><span class="nav-text">Vehicles</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Drivers" ? "active" : "")" href="/Transport/Drivers">
                            <i class="bi bi-person-badge nav-icon"></i><span class="nav-text">Drivers</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Requests" ? "active" : "")" href="/Transport/Requests">
                            <i class="bi bi-clipboard-plus nav-icon"></i><span class="nav-text">Bookings</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Trips" ? "active" : "")" href="/Transport/Trips">
                            <i class="bi bi-map nav-icon"></i><span class="nav-text">Trips</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" && ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")" href="/Transport/Reports">
                            <i class="bi bi-bar-chart-line nav-icon"></i><span class="nav-text">Transport Reports</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                    {
                        <div class="nav-section">Finance</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Financial" ? "active" : "")" href="/Financial">
                            <i class="bi bi-bar-chart-line nav-icon"></i><span class="nav-text">Financials</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Reports">
                            <i class="bi bi-file-earmark-bar-graph nav-icon"></i><span class="nav-text">Reports</span>
                        </a>
                    }

                    <div class="nav-section">My Account</div>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscription" ? "active" : "")" href="/Subscription">
                        <i class="bi bi-star nav-icon"></i>
                        <span class="nav-text">My Plan</span>
                        @{
                            var subType = User.FindFirst("SubscriptionType")?.Value ?? "";
                            if (!string.IsNullOrEmpty(subType) && subType != "Free")
                            { <span class="nav-badge">@subType</span> }
                        }
                    </a>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" href="/Account/Profile">
                        <i class="bi bi-person-circle nav-icon"></i><span class="nav-text">My Profile</span>
                    </a>

                    @if (User.IsInRole("Worker"))
                    {
                        <div class="nav-section">My Work</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "FarmJoin" && ViewContext.RouteData.Values["action"]?.ToString() == "Browse" ? "active" : "")" href="/FarmJoin/Browse">
                            <i class="bi bi-search nav-icon"></i><span class="nav-text">Browse Farms</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "FarmJoin" && ViewContext.RouteData.Values["action"]?.ToString() == "MyRequests" ? "active" : "")" href="/FarmJoin/MyRequests">
                            <i class="bi bi-list-check nav-icon"></i><span class="nav-text">My Applications</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" href="/Attendance">
                            <i class="bi bi-calendar-check nav-icon"></i><span class="nav-text">My Attendance</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaskAssignment" ? "active" : "")" href="/TaskAssignment">
                            <i class="bi bi-check2-square nav-icon"></i><span class="nav-text">My Tasks</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payroll" ? "active" : "")" href="/Payroll">
                            <i class="bi bi-credit-card-2-front nav-icon"></i><span class="nav-text">My Salary Slips</span>
                        </a>
                    }

                    @if (User.IsInRole("Owner"))
                    {
                        <div class="nav-section">Worker Management</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "FarmJoin" && ViewContext.RouteData.Values["action"]?.ToString() == "Incoming" ? "active" : "")" href="/FarmJoin/Incoming">
                            <i class="bi bi-people-fill nav-icon"></i><span class="nav-text">Join Requests</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-section">Administration</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" href="/Admin/Users">
                            <i class="bi bi-people-fill nav-icon"></i><span class="nav-text">Users</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Farms" ? "active" : "")" href="/Admin/Farms">
                            <i class="bi bi-check2-circle nav-icon"></i><span class="nav-text">Farm Approvals</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "PendingVeterinarians" ? "active" : "")" href="/Admin/PendingVeterinarians">
                            <i class="bi bi-person-check nav-icon"></i><span class="nav-text">Vet Approvals</span>
                        </a>
                        <a class="nav-item" href="/Admin/Subscriptions">
                            <i class="bi bi-credit-card nav-icon"></i><span class="nav-text">Subscriptions</span>
                        </a>
                        <a class="nav-item" href="/Admin/AuditLogs">
                            <i class="bi bi-journal-text nav-icon"></i><span class="nav-text">Audit Logs</span>
                        </a>
                        <a class="nav-item" href="/UserManagement">
                            <i class="bi bi-sliders nav-icon"></i><span class="nav-text">User Management</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Backup" ? "active" : "")" href="/Backup">
                            <i class="bi bi-database-check nav-icon"></i><span class="nav-text">DB Backup</span>
                        </a>
                    }


                    <div class="nav-section">Alerts</div>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "active" : "")" href="/Notification" id="notif-link">
                        <i class="bi bi-bell nav-icon"></i>
                        <span class="nav-text">Notifications</span>
                        <span class="nav-badge" id="notif-count" style="display:none"></span>
                    </a>
                </div>

                <!-- Sidebar Footer -->
                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        @{
                            var profileImg = User.FindFirst("ProfileImage")?.Value;
                        }
                        @if (!string.IsNullOrEmpty(profileImg))
                        {
                            <img src="@profileImg" id="sidebarAvatar" alt="Avatar" class="sidebar-avatar" />
                        }
                        else
                        {
                            <div class="sidebar-avatar-initials">@userInitials</div>
                        }
                        <div class="user-info flex-1">
                            <div class="user-name">@userDisplayName</div>
                            <div class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                        <a href="@Url.Action("Logout", "Account")" title="Sign Out" class="sidebar-logout-btn">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <div class="main-content">
                <!-- Top Header -->
                <header class="top-header">
                    <button class="header-btn" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="header-search">
                        <span class="search-icon"><i class="bi bi-search"></i></span>
                        <input type="search" placeholder="Search cattle, farms, workers..." id="globalSearch" />
                    </div>
                    <div class="header-actions">
                        <!-- Notifications -->
                        <a class="header-btn" href="/Notification" title="Notifications" aria-label="View notifications">
                            <i class="bi bi-bell"></i>
                            <span class="badge" id="header-notif-count" style="display:none"></span>
                        </a>
                        <!-- User Menu -->
                        <div class="header-user" onclick="window.location='/Account/Profile'" title="My Profile" role="button" tabindex="0" aria-label="My Profile">
                            @{
                                var hProfileImg = User.FindFirst("ProfileImage")?.Value;
                            }
                            @if (!string.IsNullOrEmpty(hProfileImg))
                            {
                                <img src="@hProfileImg" id="navAvatar" alt="Avatar" class="header-avatar" />
                            }
                            else
                            {
                                <div id="navAvatar" class="header-avatar-initials">@userInitials</div>
                            }
                            <span>@userDisplayName</span>
                            <a href="@Url.Action("Logout", "Account")" title="Sign Out" onclick="event.stopPropagation()" class="header-logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </header>

                <!-- Toast Notifications -->
                <div class="toast-container" id="toastContainer"></div>

                <!-- Flash Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div style="padding: 0 24px; margin-top: 14px;">
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["SuccessMessage"]</span>
                            <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:inherit;font-size:14px">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div style="padding: 0 24px; margin-top: 14px;">
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@TempData["ErrorMessage"]</span>
                            <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:inherit;font-size:14px">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                }

                <!-- Page Body -->
                <main class="page-content" role="main">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year Smart Cattle Farm Management System</span>
                    <span>v2.1 Enterprise</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sidebar collapse & toggle
        function toggleSidebar() {
            if (window.innerWidth > 768) {
                document.body.classList.toggle('sidebar-collapsed');
                const collapsed = document.body.classList.contains('sidebar-collapsed');
                localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false');
                const icon = document.getElementById('collapseIcon');
                if (icon) icon.className = collapsed ? 'bi bi-layout-sidebar' : 'bi bi-layout-sidebar-reverse';
            } else {
                document.getElementById('sidebar').classList.toggle('open');
                document.getElementById('sidebarOverlay').classList.toggle('open');
            }
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('open');
        }

        (function () {
            localStorage.setItem('theme', 'light');
            document.documentElement.setAttribute('data-theme', 'light');
            
            const collapsed = localStorage.getItem('sidebar-collapsed') === 'true';
            if (collapsed && window.innerWidth > 768) {
                document.body.classList.add('sidebar-collapsed');
                const icon = document.getElementById('collapseIcon');
                if (icon) icon.className = 'bi bi-layout-sidebar';
            }
        })();

        // Scroll animation observer
        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.1 });
        document.querySelectorAll('.animate-in').forEach(el => observer.observe(el));

        // Notification badge
        async function loadNotifCount() {
            try {
                const r = await fetch('/Notification/UnreadCount');
                if (!r.ok) return;
                const data = await r.json();
                const count = data.count || 0;
                ['notif-count', 'header-notif-count'].forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.style.display = count > 0 ? 'flex' : 'none';
                    el.textContent = count > 9 ? '9+' : count;
                });
            } catch {}
        }
        loadNotifCount();
        setInterval(loadNotifCount, 60000);

        // ── SignalR Real-time Notifications ────────────────────────────────
        @if (User.Identity?.IsAuthenticated == true)
        {
            var signalRUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            <text>
        (function () {
            const userId = '@signalRUserId';
            if (!userId || typeof signalR === 'undefined') return;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/farm-dashboard')
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            connection.on('NotificationReceived', function (data) {
                // Update badge
                const count = data.unreadCount || 0;
                ['notif-count', 'header-notif-count'].forEach(function (id) {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.style.display = count > 0 ? 'flex' : 'none';
                    el.textContent = count > 9 ? '9+' : count;
                });
                // Show toast
                const typeToastMap = {
                    'HealthAlert': 'error', 'Vaccination': 'warning',
                    'Appointment': 'info', 'AppointmentRequested': 'info',
                    'OrderUpdate': 'success', 'Payment': 'warning',
                    'Subscription': 'info', 'SalaryUpdate': 'info',
                    'LowFeedStock': 'warning'
                };
                const toastType = typeToastMap[data.type] || 'info';
                if (typeof showToast === 'function') {
                    showToast(data.title || 'Notification', data.message || '', toastType, 6000);
                }
            });

            connection.on('NotificationRead', function () { loadNotifCount(); });
            connection.on('NotificationsRead', function (data) {
                const count = (data && data.unreadCount) || 0;
                ['notif-count', 'header-notif-count'].forEach(function (id) {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.style.display = count > 0 ? 'flex' : 'none';
                    el.textContent = count > 9 ? '9+' : count;
                });
            });

            async function startConnection() {
                try {
                    await connection.start();
                    await connection.invoke('JoinUserGroup', userId);
                } catch (err) {
                    setTimeout(startConnection, 5000);
                }
            }

            connection.onreconnected(async function () {
                await connection.invoke('JoinUserGroup', userId);
            });

            startConnection();
        })();
            </text>
        }

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js').catch(() => {});
            });
        }
    </script>
    <script src="~/js/ui-components.js" asp-append-version="true"></script>
    <script src="~/js/ui-components-extended.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
