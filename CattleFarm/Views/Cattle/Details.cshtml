@model CattleFarm.Models.Cattle
@{
    ViewData["Title"] = $"{Model.Name} — Details";
    var likeCount = ViewBag.LikeCount as int? ?? 0;
    var hasLiked = ViewBag.HasLiked as bool? ?? false;
    var comments = ViewBag.Comments as List<CattleFarm.Models.CattleComment> ?? new List<CattleFarm.Models.CattleComment>();
    var shareUrl = ViewBag.ShareUrl as string ?? "";
}

<style>
    .category-badge { font-size:10px; padding:2px 8px; border-radius:20px; font-weight:600; letter-spacing:.5px; display:inline-block; }
    .cat-Feed       { background:rgba(245,158,11,.15); color:#d97706; }
    .cat-Medicine   { background:rgba(239,68,68,.15);  color:#dc2626; }
    .cat-Veterinary { background:rgba(139,92,246,.15); color:#7c3aed; }
    .cat-Transport  { background:rgba(59,130,246,.15); color:#2563eb; }
    .cat-Labor      { background:rgba(16,185,129,.15); color:#059669; }
    .cat-Other      { background:rgba(107,114,128,.15);color:#4b5563; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Name <small style="font-size:14px;font-weight:500;color:var(--text-muted)">(@Model.TagId)</small></h1>
        <p class="page-subtitle">@Model.Breed • @Model.Farm?.Name</p>
    </div>
    <div class="page-actions">
        <a href="/Cattle" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back</a>
        <a asp-action="ExportPdf" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-file-earmark-pdf"></i> Export PDF</a>
        <a asp-action="ExportProfileExcel" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-file-earmark-spreadsheet"></i> Export Excel</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager"))
        {
            <a href="/Cattle/Edit/@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px">@TempData["ErrorMessage"]</div>
}

<div style="display:grid;grid-template-columns:320px 1fr;gap:24px;align-items:start">
    <!-- Left: Image + Status -->
    <div style="display:flex;flex-direction:column;gap:16px">
        <div class="card">
            <div style="width:100%;height:260px;overflow:hidden;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:72px;border-radius:10px 10px 0 0">
                @if (!string.IsNullOrEmpty(Model.ImagePath)) { <img src="@Model.ImagePath" alt="@Model.Name" style="width:100%;height:260px;object-fit:cover" /> }
                else { <span></span> }
            </div>
            <div class="card-body">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                    @{
                        var hClass = Model.HealthStatus switch { CattleFarm.Models.HealthStatus.Healthy => "badge-success", CattleFarm.Models.HealthStatus.AtRisk => "badge-warning", CattleFarm.Models.HealthStatus.Sick => "badge-danger", _ => "badge-danger" };
                        var sClass = Model.Status == CattleFarm.Models.CattleStatus.Active ? "badge-success" : "badge-gray";
                    }
                    <span class="badge @hClass">@Model.HealthStatus</span>
                    <span class="badge @sClass">@Model.Status</span>
                    @if (Model.IsPremiumListing) { <span class="badge badge-warning">Premium</span> }
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px">
                    <div><div style="color:var(--text-muted);font-size:11px">AGE</div><div style="font-weight:600">@((DateTime.Now.Year - Model.DateOfBirth.Year)) years</div></div>
                    <div><div style="color:var(--text-muted);font-size:11px">WEIGHT</div><div style="font-weight:600">@Model.Weight kg</div></div>
                    <div><div style="color:var(--text-muted);font-size:11px">GENDER</div><div style="font-weight:600">@Model.Gender</div></div>
                    <div><div style="color:var(--text-muted);font-size:11px">FARM</div><div style="font-weight:600">@Model.Farm?.Name</div></div>
                </div>
                @if (Model.IsListedForSale)
                {
                    <div style="margin-top:12px;padding:10px;background:var(--primary-light);border-radius:6px;text-align:center">
                        <div style="font-size:11px;color:var(--text-muted)">SALE PRICE</div>
                        <div style="font-size:20px;font-weight:800;color:var(--primary)">@Currency.Format(Model.SalePrice)</div>
                        <a href="/Cattle/BuyCattle/@Model.Id" class="btn btn-primary w-100" style="margin-top:8px">Buy Now</a>
                    </div>
                }
            </div>
        </div>

        <div id="comments" class="card">
            <div class="card-header"><h3 class="card-title">Social</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <form asp-action="ToggleLike" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(hasLiked ? "btn-primary" : "btn-outline")">
                            <i class="bi bi-hand-thumbs-up"></i> Like @likeCount
                        </button>
                    </form>
                    <button type="button" class="btn btn-outline" onclick="document.getElementById('commentBox').focus()">
                        <i class="bi bi-chat-left-text"></i> Comment
                    </button>
                    <form asp-action="Share" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="channel" value="Link" />
                        <button type="submit" class="btn btn-outline"><i class="bi bi-share"></i> Share</button>
                    </form>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(shareUrl)">Facebook</a>
                    <a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="https://wa.me/?text=@Uri.EscapeDataString($"{Model.Name} - {shareUrl}")">WhatsApp</a>
                </div>
                <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" style="display:flex;gap:8px">
                    @Html.AntiForgeryToken()
                    <input id="commentBox" name="comment" class="form-control" maxlength="1000" placeholder="Write a comment" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
                </form>
                @if (comments.Any())
                {
                    <div style="display:flex;flex-direction:column;gap:8px">
                        @foreach (var comment in comments)
                        {
                            <div style="border-top:1px solid var(--border);padding-top:8px">
                                <div style="font-size:12px;color:var(--text-muted)">@comment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</div>
                                <div>@comment.Comment</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Quick Actions</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:8px">
                <a href="/Health/Create?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-clipboard2-pulse"></i> Add Health Record</a>
                @if (User.IsInRole("Doctor"))
                {
                    <a href="/CattleMedicalRecord/AddMedicalRecord?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-journal-medical"></i> Log Examination</a>
                }
                <a href="/CattleMedicalRecord/MedicalHistory?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-clock-history"></i> Medical History</a>
                <a href="/Health/AddVaccination?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-shield-plus"></i> Log Vaccination</a>
                <a href="/Appointment/Create?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-calendar-plus"></i> Book Appointment</a>
                <a href="/MilkProduction/Create?farmId=@Model.FarmId" class="btn btn-outline"><i class="bi bi-droplet"></i> Log Milk</a>
                <a href="/Cattle/WeightHistory?cattleId=@Model.Id" class="btn btn-outline"><i class="bi bi-graph-up"></i> Weight History</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager"))
                {
                    <a href="#cattle-expenses-section" class="btn btn-outline"><i class="bi bi-currency-dollar"></i> Log Cattle Expense</a>
                    @if (Model.Status == CattleFarm.Models.CattleStatus.Active)
                    {
                        <a href="/Cattle/Transfer/@Model.Id" class="btn btn-outline" style="color:var(--warning);border-color:var(--warning)"><i class="bi bi-truck"></i> Transfer Cattle</a>
                    }
                }
                @if ((User.IsInRole("Admin") || User.IsInRole("Owner")) && Model.Status == CattleFarm.Models.CattleStatus.Active)
                {
                    <hr style="margin:4px 0;border-color:var(--border)" />
                    @if (Model.IsListedForSale)
                    {
                        <a href="/Cattle/SellCattle/@Model.Id"
                           class="btn"
                           style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;font-weight:600">
                            <i class="bi bi-tag-fill"></i> Manage Sale Listing
                        </a>
                        <div style="font-size:11px;color:#2563eb;text-align:center;margin-top:4px;font-weight:600">
                            <i class="bi bi-check-circle-fill"></i> Listed on Marketplace
                        </div>
                    }
                    else
                    {
                        <a href="/Cattle/SellCattle/@Model.Id"
                           class="btn"
                           style="background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;font-weight:600">
                            <i class="bi bi-tag"></i> Sell This Cattle
                        </a>
                    }
                }
                @if (Model.Status == CattleFarm.Models.CattleStatus.Sold)
                {
                    <div style="background:rgba(22,163,74,.1);border:1px solid rgba(22,163,74,.3);border-radius:8px;padding:10px;text-align:center;font-size:13px">
                        <div style="font-weight:700;color:#16a34a"><i class="bi bi-check-circle-fill"></i> Sold</div>
                        @if (Model.SalePrice.HasValue)
                        { <div style="color:var(--text-muted);margin-top:4px">@Model.SalePrice?.ToString("N0") BDT &mdash; @Model.SaleDate?.ToString("MMM dd, yyyy")</div> }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Details Tabs -->
    <div style="display:flex;flex-direction:column;gap:20px">
        <!-- Health Records -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Recent Health Records</h3>
                <a href="/Health?cattleId=@Model.Id" class="btn btn-ghost btn-sm">View all</a>
            </div>
            <div class="table-wrapper">
                @if (!Model.HealthRecords.Any())
                { <div class="empty-state" style="padding:30px"><div class="empty-icon"></div><p>No health records yet</p></div> }
                else
                {
                    <table class="data-table">
                        <thead><tr><th>Date</th><th>Status</th><th>Risk</th><th>Temp</th><th>Notes</th></tr></thead>
                        <tbody>
                            @foreach (var h in Model.HealthRecords.Take(5))
                            {
                                <tr>
                                    <td>@h.RecordDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge @(h.HealthStatus == CattleFarm.Models.HealthStatus.Healthy ? "badge-success" : "badge-danger")">@h.HealthStatus</span></td>
                                    <td><span class="badge @(h.RiskLevel == CattleFarm.Models.RiskLevel.Low ? "badge-success" : h.RiskLevel == CattleFarm.Models.RiskLevel.Medium ? "badge-warning" : "badge-danger")">@h.RiskLevel</span></td>
                                    <td>@(h.Temperature.HasValue ? $"{h.Temperature}°C" : "—")</td>
                                    <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(h.Notes ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Medical History (Veterinary Examinations) -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Medical History</h3>
                <a href="/CattleMedicalRecord/MedicalHistory?cattleId=@Model.Id" class="btn btn-ghost btn-sm">View all</a>
            </div>
            <div class="table-wrapper">
                @if (!Model.MedicalRecords.Any())
                { <div class="empty-state" style="padding:30px"><div class="empty-icon"></div><p>No veterinary examinations logged yet</p></div> }
                else
                {
                    <table class="data-table">
                        <thead><tr><th>Date</th><th>Doctor</th><th>Complaint</th><th>Diagnosis</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in Model.MedicalRecords.Take(5))
                            {
                                <tr>
                                    <td>@m.ExaminationDate.ToString("MMM dd, yyyy")</td>
                                    <td>@(m.Doctor?.FullName ?? "—")</td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@m.ChiefComplaint</td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@m.Diagnosis</td>
                                    <td><a href="/CattleMedicalRecord/MedicalHistory?cattleId=@Model.Id" class="btn btn-ghost btn-sm">Details</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Vaccinations -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Vaccination History</h3>
                <a href="/Health/Vaccinations?cattleId=@Model.Id" class="btn btn-ghost btn-sm">View all</a>
            </div>
            <div class="table-wrapper">
                @if (!Model.Vaccinations.Any())
                { <div class="empty-state" style="padding:30px"><div class="empty-icon"></div><p>No vaccinations recorded</p></div> }
                else
                {
                    <table class="data-table">
                        <thead><tr><th>Vaccine</th><th>Date</th><th>Next Due</th><th>Dose</th></tr></thead>
                        <tbody>
                            @foreach (var v in Model.Vaccinations.Take(5))
                            {
                                var isOverdue = v.NextDueDate.HasValue && v.NextDueDate < DateTime.Now;
                                <tr>
                                    <td style="font-weight:500">@v.VaccineName</td>
                                    <td>@v.VaccinationDate.ToString("MMM dd, yyyy")</td>
                                    <td style="color:@(isOverdue ? "var(--danger)" : "inherit")">
                                        @(v.NextDueDate?.ToString("MMM dd, yyyy") ?? "—")
                                        @if (isOverdue) { <span class="badge badge-danger" style="margin-left:4px">Overdue</span> }
                                    </td>
                                    <td>Dose @v.DoseNumber</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Milk Production Chart -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Milk Production (Last 30 days)</h3>
            </div>
            <div class="card-body">
                <div class="chart-container" style="height:200px">
                    <canvas id="milkChart"></canvas>
                </div>
            </div>
        </div>

        @* ── Costing & Expense History ─────────────────────────────────── *@
        @{
            var expenses     = Model.CattleExpenses.Where(e => !e.IsDeleted).OrderByDescending(e => e.Date).ToList();
            var totalExp     = expenses.Sum(e => e.Amount);
            var totalInvest  = Model.PurchasePrice + totalExp;
            var returnUrl    = $"/Cattle/Details/{Model.Id}#cattle-expenses-section";
        }
        <div id="cattle-expenses-section" class="card" style="border:2px solid rgba(37,99,235,.18)">
            <div class="card-header" style="background:linear-gradient(135deg,rgba(37,99,235,.07),rgba(37,99,235,.03))">
                <h3 class="card-title" style="color:#2563eb">
                    <i class="bi bi-wallet2"></i> Costing &amp; Expense History
                </h3>
                <span class="badge badge-gray">@expenses.Count entries</span>
            </div>
            <div class="card-body">

                @* ─ Financial Summary Grid ─ *@
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px">
                    <div style="background:var(--bg);border-radius:10px;padding:14px;text-align:center">
                        <div style="font-size:10px;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px">Purchase Price</div>
                        <div style="font-size:16px;font-weight:800;color:var(--text)">@Model.PurchasePrice.ToString("N0") ৳</div>
                    </div>
                    <div style="background:rgba(239,68,68,.07);border-radius:10px;padding:14px;text-align:center">
                        <div style="font-size:10px;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px">Total Expense</div>
                        <div style="font-size:16px;font-weight:800;color:#dc2626">@totalExp.ToString("N0") ৳</div>
                    </div>
                    <div style="background:rgba(124,58,237,.07);border-radius:10px;padding:14px;text-align:center">
                        <div style="font-size:10px;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px">Total Investment</div>
                        <div style="font-size:16px;font-weight:800;color:#7c3aed">@totalInvest.ToString("N0") ৳</div>
                    </div>
                    @if (Model.Status == CattleFarm.Models.CattleStatus.Sold && Model.SalePrice.HasValue)
                    {
                        var netPnL   = Model.SalePrice.Value - totalInvest;
                        var isProfit = netPnL >= 0;
                        <div style="background:@(isProfit ? "rgba(22,163,74,.07)" : "rgba(239,68,68,.07)");border-radius:10px;padding:14px;text-align:center">
                            <div style="font-size:10px;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px">@(isProfit ? "Profit" : "Loss")</div>
                            <div style="font-size:16px;font-weight:800;color:@(isProfit ? "#16a34a" : "#dc2626")">
                                @(isProfit ? "+" : "")@netPnL.ToString("N0") ৳
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="background:rgba(107,114,128,.07);border-radius:10px;padding:14px;text-align:center">
                            <div style="font-size:10px;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px">Sale Price</div>
                            <div style="font-size:14px;font-weight:600;color:var(--text-muted)">—</div>
                        </div>
                    }
                </div>

                @* ─ Add New Expense Form ─ *@
                @if ((User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager")) && Model.Status != CattleFarm.Models.CattleStatus.Sold)
                {
                    <div style="background:var(--bg);border-radius:10px;padding:16px;margin-bottom:20px">
                        <p style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px">
                            <i class="bi bi-plus-circle"></i> Add New Expense
                        </p>
                        <form asp-action="AddCattleExpense" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CattleId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div style="display:grid;grid-template-columns:150px 1fr 130px 130px auto;gap:10px;align-items:end">
                                <div>
                                    <label class="form-label" style="font-size:11px">Category</label>
                                    <select name="Category" class="form-control" style="font-size:13px">
                                        @foreach (var cat in Enum.GetValues<CattleFarm.Models.CattleExpenseCategory>())
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" style="font-size:11px">Description</label>
                                    <input name="Description" class="form-control" placeholder="e.g. Feed for June" style="font-size:13px" maxlength="500" />
                                </div>
                                <div>
                                    <label class="form-label" style="font-size:11px">Amount (৳)</label>
                                    <input name="Amount" type="number" min="1" step="0.01" class="form-control" placeholder="0" required style="font-size:13px" />
                                </div>
                                <div>
                                    <label class="form-label" style="font-size:11px">Date</label>
                                    <input name="Date" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" style="font-size:13px" />
                                </div>
                                <div style="padding-top:20px">
                                    <button type="submit" class="btn btn-primary" style="white-space:nowrap">
                                        <i class="bi bi-plus-lg"></i> Add
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                }

                @* ─ Expense History Table ─ *@
                @if (!expenses.Any())
                {
                    <div class="empty-state" style="padding:30px">
                        <div class="empty-icon">💰</div>
                        <p style="margin-top:8px">No expenses logged yet.</p>
                        @if (Model.Status != CattleFarm.Models.CattleStatus.Sold && (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager")))
                        {
                            <p style="font-size:13px;color:var(--text-muted)">Use the form above to add an expense.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th style="text-align:right">Amount</th>
                                    @if (Model.Status != CattleFarm.Models.CattleStatus.Sold && (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager")))
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in expenses)
                                {
                                    <tr>
                                        <td><span class="category-badge cat-@exp.Category">@exp.Category</span></td>
                                        <td style="color:var(--text-muted);font-size:13px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                            @(exp.Description ?? "—")
                                        </td>
                                        <td style="font-size:12px;color:var(--text-muted);white-space:nowrap">@exp.Date.ToString("dd MMM yyyy")</td>
                                        <td style="text-align:right;font-weight:700;color:#dc2626">@exp.Amount.ToString("N0") ৳</td>
                                        @if (Model.Status != CattleFarm.Models.CattleStatus.Sold && (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager")))
                                        {
                                            <td>
                                                <form asp-action="DeleteCattleExpense" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@exp.Id" />
                                                    <input type="hidden" name="cattleId" value="@Model.Id" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)"
                                                            onclick="return confirm('Are you sure you want to delete this expense?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background:var(--bg)">
                                    <td colspan="2" style="font-weight:700;padding:12px 16px;font-size:13px">
                                        Total Investment = Purchase (@Model.PurchasePrice.ToString("N0") ৳) + Expense (@totalExp.ToString("N0") ৳)
                                    </td>
                                    <td style="font-size:12px;color:var(--text-muted);padding:12px 16px">@expenses.Count entries</td>
                                    <td style="text-align:right;font-weight:800;font-size:16px;color:#7c3aed;padding:12px 16px">@totalInvest.ToString("N0") ৳</td>
                                    @if (Model.Status != CattleFarm.Models.CattleStatus.Sold && (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager")))
                                    {
                                        <td></td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
const milkDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilkProductions.Select(m => m.Date.ToString("MMM dd")).ToList()));
const milkYields = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilkProductions.Select(m => m.MorningYieldLiters + m.EveningYieldLiters).ToList()));
new Chart(document.getElementById('milkChart'), {
    type: 'line',
    data: { labels: milkDates, datasets: [{ label: 'Total Yield (L)', data: milkYields, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,.1)', tension: .4, fill: true, pointRadius: 3 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true }, x: { grid: { display: false } } } }
});
</script>
}
