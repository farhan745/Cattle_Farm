@model CattleFarm.ViewModels.CattleTransferViewModel
@{
    ViewData["Title"] = "Transfer Cattle";
}

<div class="page-header animate-fade-in">
    <div>
        <h1 class="page-title text-gradient">Transfer Cattle</h1>
        <p class="page-subtitle">Mark animal <strong>@Model.CattleName</strong> (@Model.TagId) as transferred to another farm or partner.</p>
    </div>
    <a href="/Cattle/Details/@Model.CattleId" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to Details</a>
</div>

<div class="row animate-slide-up" style="max-width: 600px; margin: 0 auto;">
    <div class="col-md-12">
        <div class="card glass-card shadow-lg">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-truck text-warning"></i> Transfer Details</h3>
            </div>
            <div class="card-body">
                <form asp-action="Transfer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CattleId" />
                    <input type="hidden" asp-for="CattleName" />
                    <input type="hidden" asp-for="TagId" />

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Destination / Partner Name *</label>
                        <input asp-for="TransferredTo" class="form-control form-control-lg" placeholder="e.g. Rajshahi Research Farm, Partner A" required />
                        <span asp-validation-for="TransferredTo" class="form-error"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Transfer Date *</label>
                        <input asp-for="TransferDate" class="form-control" type="date" required />
                        <span asp-validation-for="TransferDate" class="form-error"></span>
                    </div>

                    <div class="alert alert-warning" role="alert" style="border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Warning:</strong> Transferring this cattle will change its status to <strong>Transferred</strong>. It will be marked inactive but its historical records (milk yield, health, weight logs) will be preserved.
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-warning btn-lg flex-grow-1 text-white shadow-sm">
                            <i class="bi bi-check2-circle"></i> Confirm Transfer
                        </button>
                        <a href="/Cattle/Details/@Model.CattleId" class="btn btn-outline btn-lg flex-grow-1">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
