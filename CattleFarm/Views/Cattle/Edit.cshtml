@model CattleFarm.ViewModels.CattleViewModel
@{
    ViewData["Title"] = "Edit Cattle";
}

<div class="page-header animate-fade-in">
    <div>
        <h1 class="page-title text-gradient">Edit Cattle Record</h1>
        <p class="page-subtitle">Update registration details for <strong>@Model.Name</strong></p>
    </div>
    <a href="/Cattle/Details/@Model.Id" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to Details</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="animate-slide-up">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImagePath" />

    <div style="display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start">
        <!-- Main Form Content -->
        <div style="display:flex;flex-direction:column;gap:20px">
            <!-- Basic Details -->
            <div class="card glass-card">
                <div class="card-header">
                    <h3 class="card-title"><i class="bi bi-card-text text-primary"></i> Basic Information</h3>
                </div>
                <div class="card-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                        <div class="form-group">
                            <label class="form-label">Tag ID *</label>
                            <input asp-for="TagId" class="form-control" placeholder="e.g. GF-001" required />
                            <span asp-validation-for="TagId" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cattle Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Lali" required />
                            <span asp-validation-for="Name" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cattle Category</label>
                            <select asp-for="Category" class="form-control" asp-items="Html.GetEnumSelectList<CattleFarm.Models.CattleCategory>()"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Breed *</label>
                            <input asp-for="Breed" class="form-control" placeholder="e.g. Holstein Friesian" required />
                            <span asp-validation-for="Breed" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Date of Birth *</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" required />
                            <span asp-validation-for="DateOfBirth" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Weight (kg) *</label>
                            <input asp-for="Weight" class="form-control" type="number" step="0.1" placeholder="0.0" required />
                            <span asp-validation-for="Weight" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<CattleFarm.Models.Gender>()"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Health Status</label>
                            <select asp-for="HealthStatus" class="form-control" asp-items="Html.GetEnumSelectList<CattleFarm.Models.HealthStatus>()"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<CattleFarm.Models.CattleStatus>()"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Origin / Source</label>
                            <input asp-for="Origin" class="form-control" placeholder="e.g. Kushtia Market" />
                            <span asp-validation-for="Origin" class="form-error"></span>
                        </div>
                        <div class="form-group" style="grid-column: span 2">
                            <label class="form-label">Farm *</label>
                            <select asp-for="FarmId" class="form-control" required>
                                <option value="">Select farm...</option>
                                @foreach (var farm in (IEnumerable<CattleFarm.Models.Farm>)ViewBag.Farms)
                                {
                                    <option value="@farm.Id" selected="@(farm.Id == Model.FarmId)">@farm.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group" style="margin-top: 15px">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Any additional notes..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Financial Details -->
            <div class="card glass-card">
                <div class="card-header">
                    <h3 class="card-title"><i class="bi bi-cash-coin text-success"></i> Financial Details</h3>
                </div>
                <div class="card-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                        <div class="form-group">
                            <label class="form-label">Purchase Price (BDT)</label>
                            <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Purchase Date</label>
                            <input asp-for="PurchaseDate" class="form-control" type="date" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sale Price (BDT)</label>
                            <input asp-for="SalePrice" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sale Date</label>
                            <input asp-for="SaleDate" class="form-control" type="date" />
                        </div>
                    </div>
                    <div style="display:flex;gap:24px;margin-top:12px">
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
                            <input asp-for="IsListedForSale" type="checkbox" style="accent-color:var(--primary)" />
                            List for sale in marketplace
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
                            <input asp-for="IsPremiumListing" type="checkbox" style="accent-color:var(--accent)" />
                            Premium listing
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Media upload -->
        <div style="display:flex;flex-direction:column;gap:20px">
            <div class="card glass-card">
                <div class="card-header">
                    <h3 class="card-title"><i class="bi bi-image text-info"></i> Cattle Image</h3>
                </div>
                <div class="card-body" style="text-align:center">
                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <img id="imagePreview" src="@Model.ExistingImagePath" class="img-preview" style="width:100%;height:200px;border-radius:8px;object-fit:cover;margin-bottom:12px" alt="Current image" />
                    }
                    else
                    {
                        <div style="width:100%;height:200px;background:var(--bg-accent, #eee);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:48px;margin-bottom:12px;color:var(--text-muted)" id="imagePlaceholder">
                            <i class="bi bi-image"></i>
                        </div>
                        <img id="imagePreview" style="display:none;width:100%;height:200px;object-fit:cover;border-radius:8px;margin-bottom:12px" />
                    }
                    <label class="img-upload-zone" for="imageInput" style="display:block;border:2px dashed var(--primary);border-radius:8px;padding:15px;cursor:pointer">
                        <i class="bi bi-cloud-arrow-up text-primary" style="font-size:24px"></i>
                        <div style="font-size:13px;font-weight:600;margin-top:5px">Change Image</div>
                        <div style="font-size:11px;color:var(--text-muted)">Max 5MB (JPG, PNG, WebP)</div>
                    </label>
                    <input type="file" name="ImageFile" id="imageInput" accept="image/*" style="display:none" onchange="previewImage(this,'imagePreview');document.getElementById('imagePlaceholder')?.remove()" />
                </div>
            </div>

            <div class="card glass-card">
                <div class="card-body">
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a href="/Cattle/Details/@Model.Id" class="btn btn-outline w-100" style="margin-top:10px">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewImage(input, previewId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = document.getElementById(previewId);
                    img.src = e.target.result;
                    img.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
