@{
    Layout = null;
    ViewData["Title"] = "Smart Cattle Farm — Premium Livestock Management";

    var features = new[] {
        ("bi-clipboard2-pulse", "Herd records", "Track every animal profile, health state, breed, lifecycle event, and ownership detail in one clean workspace."),
        ("bi-heart-pulse", "Health monitoring", "Manage medical history, vaccination schedules, veterinarian visits, and risk alerts before small issues become expensive."),
        ("bi-droplet-half", "Milk production", "Log daily milk yield, compare trends, and identify top producers across farms and time periods."),
        ("bi-cash-coin", "Financial control", "Monitor revenue, expenses, payroll, ROI, and cost per litre with export-ready reporting."),
        ("bi-people", "Worker operations", "Coordinate attendance, tasks, farm roles, and staff performance without scattered paper trails."),
        ("bi-shop", "Marketplace ready", "List cattle, review buyer interest, and support secure farm commerce from the same platform.")
    };

    var plans = new[] {
        ("Starter", "For smaller farms moving from notebooks to software.", "Free", "forever", new[] { "1 farm workspace", "10 cattle profiles", "Basic dashboard", "Community support" }, false),
        ("Pro", "For growing dairy and beef operations.", $"{Currency.GetSettings().Symbol}2,999", "/month", new[] { "Unlimited cattle", "Milk and health analytics", "Financial reports", "Priority support", "PDF and Excel export" }, true),
        ("Enterprise", "For cooperatives and multi-farm operators.", $"{Currency.GetSettings().Symbol}5,000", "/month", new[] { "Everything in Pro", "Manager and worker roles", "Custom onboarding", "Dedicated support", "SLA-ready operations" }, false)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Cattle Farm — Premium Livestock Management</title>
    <meta name="description" content="A premium cattle farm management platform for herd records, health, milk production, finance, workers, and marketplace operations." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations-advanced.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-components-extended.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium-effects.css" asp-append-version="true" />
</head>
<body class="landing-page">
    <nav class="landing-nav" data-landing-nav>
        <a href="/" class="landing-brand" aria-label="Smart Cattle Farm home">
            <span class="landing-brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>
            <span>Smart Cattle Farm</span>
        </a>
        <div class="landing-nav-links">
            <a href="#features">Features</a>
            <a href="#pricing">Pricing</a>
            <a href="#operations">Operations</a>
        </div>
        <div class="landing-nav-actions">
            <a href="/Account/Login" class="btn btn-ghost">Sign in</a>
            <a href="/Dashboard" class="btn btn-primary">Open dashboard <i class="bi bi-arrow-right"></i></a>
        </div>
    </nav>

    <main>
        <section class="landing-hero">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-12 col-lg-6">
                        <div class="landing-hero-copy stagger">
                            <div class="landing-pill"><span></span> Farm operations workspace</div>
                            <h1>Modern cattle farm management for <span class="text-gradient">healthier, more profitable herds</span></h1>
                            <p>Run cattle records, milk production, worker operations, health schedules, marketplace listings, and financial reporting from a single calm dashboard.</p>
                            <div class="landing-hero-actions">
                                <a href="/Dashboard" class="btn btn-primary btn-lg landing-glow-btn">Open dashboard <i class="bi bi-arrow-right"></i></a>
                                <a href="#features" class="btn btn-outline btn-lg">Explore features</a>
                            </div>
                            <div class="landing-trust-line">
                                <span><i class="bi bi-check2"></i> 14-day trial</span>
                                <span><i class="bi bi-check2"></i> No credit card</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="landing-hero-media animate-in">
                            <img src="/uploads/farms/e95dc281-5d3f-4505-be88-0b8eb10e1439.webp" alt="Managed cattle farm field" />
                            <div class="landing-float-card landing-float-yield">
                                <span><i class="bi bi-droplet-half"></i></span>
                                <div>
                                    <small>Today's milk yield</small>
                                    <strong>1,284 L</strong>
                                    <em><i class="bi bi-arrow-up-right"></i> 8.2%</em>
                                </div>
                            </div>
                            <div class="landing-float-card landing-float-health">
                                <div>
                                    <small>Herd health score</small>
                                    <strong>94/100</strong>
                                    <span class="landing-mini-progress"><i></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-section" id="features">
            <div class="container">
                <div class="landing-section-head">
                    <span class="landing-eyebrow">Platform features</span>
                    <h2>Everything a farm team needs to stay aligned.</h2>
                    <p>Built for repeated daily use: fast scanning, clear records, reliable alerts, and dashboards that explain the farm at a glance.</p>
                </div>
                <div class="row g-4">
                    @foreach (var feature in features)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <article class="landing-feature-card animate-in">
                                <span><i class="bi @feature.Item1"></i></span>
                                <h3>@feature.Item2</h3>
                                <p>@feature.Item3</p>
                            </article>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="landing-section landing-showcase-section" id="operations">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-12 col-lg-5">
                        <span class="landing-eyebrow">Owner dashboard</span>
                        <h2 class="landing-split-title">See herd health, production, and finance in one operational view.</h2>
                        <p class="landing-split-copy">Owners get a high-signal command center for production trends, high-risk cattle, cost visibility, and worker capacity.</p>
                        <ul class="landing-checklist">
                            <li><i class="bi bi-check2"></i> Daily milk trend comparison</li>
                            <li><i class="bi bi-check2"></i> Herd status and risk summaries</li>
                            <li><i class="bi bi-check2"></i> Revenue, expenses, ROI, and cost per litre</li>
                            <li><i class="bi bi-check2"></i> Top producer and activity feeds</li>
                        </ul>
                        <a href="/Dashboard" class="btn btn-primary">Open dashboard <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="col-12 col-lg-7">
                        <div class="landing-dashboard-preview animate-in">
                            <div class="landing-preview-shell">
                                <div class="landing-preview-top">
                                    <span></span><span></span><span></span>
                                </div>
                                <div class="landing-preview-inner">
                                    <div class="landing-preview-kpis">
                                        <div><small>Total cattle</small><strong>428</strong></div>
                                        <div><small>Milk today</small><strong>1,284 L</strong></div>
                                        <div><small>Workers</small><strong>38</strong></div>
                                        <div><small>Revenue</small><strong>@Currency.GetSettings().Symbol 2.4M</strong></div>
                                    </div>
                                    <div class="landing-mini-chart">
                                        <span style="height:42%"></span>
                                        <span style="height:64%"></span>
                                        <span style="height:48%"></span>
                                        <span style="height:76%"></span>
                                        <span style="height:58%"></span>
                                        <span style="height:86%"></span>
                                        <span style="height:72%"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-section landing-pricing-section" id="pricing">
            <div class="container">
                <div class="landing-section-head">
                    <span class="landing-eyebrow">Pricing</span>
                    <h2>Start small, scale when the farm grows.</h2>
                    <p>Three plans with the core workflows farms expect: records, analytics, reporting, and support.</p>
                </div>
                <div class="row g-4 align-items-stretch">
                    @foreach (var plan in plans)
                    {
                        <div class="col-12 col-lg-4">
                            <article class="landing-price-card @(plan.Item6 ? "is-popular" : "") animate-in">
                                @if (plan.Item6)
                                {
                                    <div class="landing-popular-pill">Most popular</div>
                                }
                                <h3>@plan.Item1</h3>
                                <p>@plan.Item2</p>
                                <div class="landing-price"><strong>@plan.Item3</strong><span>@plan.Item4</span></div>
                                <ul>
                                    @foreach (var item in plan.Item5)
                                    {
                                        <li><i class="bi bi-check2"></i> @item</li>
                                    }
                                </ul>
                                <a href="/Account/Register" class="btn @(plan.Item6 ? "btn-primary" : "btn-outline") w-100">@(plan.Item6 ? "Start Pro" : "Choose plan")</a>
                            </article>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="landing-cta-section">
            <div class="container">
                <div class="landing-cta-banner">
                    <div>
                        <h2>Bring the whole farm into one clear operating system.</h2>
                        <p>Start with the workflows that matter most today, then expand into analytics, marketplace, and reporting as your operation grows.</p>
                    </div>
                    <div class="landing-cta-actions">
                        <a href="/Account/Register" class="btn landing-white-btn">Create account</a>
                        <a href="/Account/Login" class="btn landing-outline-white-btn">Sign in</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="landing-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-lg-5">
                    <a href="/" class="landing-brand">
                        <span class="landing-brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>
                        <span>Smart Cattle Farm</span>
                    </a>
                    <p>Premium cattle farm management for records, production, health, finance, workers, and marketplace operations.</p>
                    <div class="landing-footer-trust"><i class="bi bi-shield-check"></i> Role-based access · Secure account controls</div>
                </div>
                <div class="col-6 col-lg">
                    <h3>Product</h3>
                    <a href="#features">Features</a>
                    <a href="#pricing">Pricing</a>
                    <a href="/Dashboard">Dashboard</a>
                    <a href="/Cattle/Marketplace">Marketplace</a>
                </div>
                <div class="col-6 col-lg">
                    <h3>Company</h3>
                    <a href="#operations">Operations</a>
                    <a href="/Account/Register">Get started</a>
                    <a href="mailto:support@smartcattlefarm.com">Contact</a>
                </div>
                <div class="col-6 col-lg">
                    <h3>Resources</h3>
                    <a href="/Account/Login">Sign in</a>
                    <a href="/Reports">Reports</a>
                    <a href="/Financial">Financials</a>
                    <a href="/Health">Health</a>
                </div>
            </div>
            <div class="landing-footer-bottom">
                <span>© @DateTime.Now.Year Smart Cattle Farm. All rights reserved.</span>
                <span>Built for modern livestock operations.</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui-components.js" asp-append-version="true"></script>
    <script src="~/js/animations-advanced.js" asp-append-version="true"></script>
    <script src="~/js/ui-components-extended.js" asp-append-version="true"></script>
</body>
</html>
