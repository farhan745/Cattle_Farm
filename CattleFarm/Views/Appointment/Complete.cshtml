@model CattleFarm.ViewModels.CompleteAppointmentViewModel
@{
    ViewData["Title"] = "Complete visit";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Complete visit</h1>
        <p class="page-subtitle">Upload evidence and prescription for the farm owner</p>
    </div>
    <a href="/Appointment/Details/@Model.Id" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="max-width:640px;margin:0 auto">
    <form asp-action="Complete" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">@Html.ValidationSummary(true)</div>
                }
                <div class="form-group">
                    <label class="form-label">Visit evidence (photo) *</label>
                    <input asp-for="EvidenceFile" type="file" class="form-control" accept="image/*" required />
                    <span asp-validation-for="EvidenceFile" class="form-error"></span>
                    <small class="text-muted">Photo showing work done (JPG, PNG, max 5 MB)</small>
                </div>
                <div class="form-group">
                    <label class="form-label">Prescription *</label>
                    <input asp-for="PrescriptionFile" type="file" class="form-control" accept="image/*,.pdf" required />
                    <span asp-validation-for="PrescriptionFile" class="form-error"></span>
                    <small class="text-muted">Image or PDF (max 5 MB)</small>
                </div>
                <div class="form-group">
                    <label class="form-label">Completion notes</label>
                    <textarea asp-for="CompletionNotes" class="form-control" rows="3" placeholder="Summary for the owner..."></textarea>
                </div>
            </div>
            <div class="card-footer" style="display:flex;justify-content:flex-end;gap:12px">
                <a href="/Appointment/Details/@Model.Id" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Submit &amp; notify owner</button>
            </div>
        </div>
    </form>
</div>
