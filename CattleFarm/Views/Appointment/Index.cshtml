@model IEnumerable<CattleFarm.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
    var isDoctor = ViewBag.IsDoctor == true;
    var isOwner  = ViewBag.IsOwner == true;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Appointments</h1>
        <p class="page-subtitle">
            @(isDoctor ? "Requests assigned to you only" : isOwner ? "Your farm booking requests" : "Veterinary appointment scheduling")
        </p>
    </div>
    @if (isOwner || User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="page-actions">
            <a href="/Appointment/Create" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Book Veterinarian</a>
        </div>
    }
</div>

<div class="card">
    <div class="table-wrapper">
        @if (!Model.Any())
        {
            <div class="empty-state" style="padding:40px">
                <div class="empty-icon"></div>
                <h3>No appointments</h3>
                @if (isOwner) { <p>Book a veterinarian from the Veterinarians page.</p> }
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Cattle</th>
                        @if (!isDoctor) { <th>Veterinarian</th> }
                        <th>Farm</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var sBadge = a.Status switch {
                            CattleFarm.Models.AppointmentStatus.Completed  => "badge-success",
                            CattleFarm.Models.AppointmentStatus.Accepted     => "badge-info",
                            CattleFarm.Models.AppointmentStatus.Pending      => "badge-warning",
                            CattleFarm.Models.AppointmentStatus.Cancelled    => "badge-danger",
                            CattleFarm.Models.AppointmentStatus.Rejected     => "badge-danger",
                            CattleFarm.Models.AppointmentStatus.NoShow       => "badge-warning",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td>
                                <div style="font-weight:600;font-size:13px">@a.ScheduledAt.ToString("MMM dd, yyyy")</div>
                                <div style="font-size:11px;color:var(--text-muted)">@a.ScheduledAt.ToString("HH:mm")</div>
                            </td>
                            <td><a href="/Cattle/Details/@a.CattleId" style="font-weight:600">@(a.Cattle?.Name ?? "—")</a></td>
                            @if (!isDoctor)
                            {
                                <td>Dr. @(a.Doctor?.FullName ?? "—")</td>
                            }
                            <td style="font-size:12px">@(a.Farm?.Name ?? "—")</td>
                            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px">@a.Reason</td>
                            <td><span class="badge @sBadge">@a.Status</span></td>
                            <td>
                                <a href="/Appointment/Details/@a.Id" class="btn btn-ghost btn-sm"><i class="bi bi-eye"></i> View</a>
                                @if (isDoctor && a.Status == CattleFarm.Models.AppointmentStatus.Pending)
                                {
                                    <form method="post" asp-action="Approve" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Accept</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
