@model CattleFarm.ViewModels.DoctorViewModel
@{
    ViewData["Title"] = "Edit My Profile";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Edit Veterinarian Profile</h1>
        <p class="page-subtitle">Update your public listing on the platform</p>
    </div>
    <a href="/Doctor" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImagePath" />

    <div style="display:grid;grid-template-columns:1fr 300px;gap:24px;align-items:start">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Professional details</h3></div>
            <div class="card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div class="form-group" style="grid-column:1/-1">
                        <label class="form-label">Full Name *</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="form-error"></span>
                    </div>
                    <div class="form-group" style="grid-column:1/-1">
                        <label class="form-label">Specialization *</label>
                        <input asp-for="Specialization" class="form-control" />
                        <span asp-validation-for="Specialization" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">License Number</label>
                        <input asp-for="LicenseNumber" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Consultation Fee (@Currency.GetSettings().Symbol)</label>
                        <input asp-for="ConsultationFee" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" readonly style="background:#f1f5f9" />
                    </div>
                    <div class="form-group" style="grid-column:1/-1">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                            <input asp-for="IsAvailable" type="checkbox" />
                            <span class="form-label" style="margin:0">Currently available for appointments</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Photo</h3></div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <img id="docPreview" src="@Model.ExistingImagePath" style="width:100%;height:220px;object-fit:cover;border-radius:8px;margin-bottom:12px" alt="Profile" />
                }
                <input type="file" name="ImageFile" accept="image/*" class="form-control" />
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary w-100">Save changes</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
