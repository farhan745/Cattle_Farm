@model CattleFarm.ViewModels.DoctorSelfRegisterVM
@{
    Layout = null;
    ViewData["Title"] = "Register as Veterinarian";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register as Veterinarian — Smart Cattle Farm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'IBM Plex Sans', system-ui, sans-serif; background: #f3f6f4; min-height: 100vh; padding: 40px 20px; margin: 0; }
        .wrap { max-width: 640px; margin: 0 auto; }
        .card { background: #fff; border-radius: 12px; border: 1px solid #e8e0d4; padding: 32px; box-shadow: 0 4px 24px rgba(0,0,0,.06); }
        h1 { font-size: 24px; margin: 0 0 8px; color: #1c3a2a; }
        .sub { color: #6b6b66; font-size: 14px; margin-bottom: 24px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .full { grid-column: 1 / -1; }
        .form-group { margin-bottom: 0; }
        .form-label { font-weight: 600; font-size: 13px; display: block; margin-bottom: 6px; }
        .form-control { width: 100%; padding: 10px 12px; border: 1px solid #ddd5c8; border-radius: 8px; }
        .btn-primary { width: 100%; margin-top: 20px; padding: 12px; background: #137a3a; color: #fff; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; }
        .footer { text-align: center; margin-top: 20px; font-size: 14px; }
        .footer a { color: #137a3a; font-weight: 700; text-decoration: none; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card">
            <h1><i class="bi bi-heart-pulse-fill" style="color:#137a3a"></i> Register as Veterinarian</h1>
            <p class="sub">Join as a global veterinarian — work with cattle across all farms on the platform.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:16px;font-size:14px;"></div>
            }

            <form asp-action="RegisterVeterinarian" asp-controller="Doctor" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="grid">
                    <div class="form-group full">
                        <label class="form-label" asp-for="FullName">Full Name *</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group full">
                        <label class="form-label" asp-for="Email">Email *</label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Password">Password *</label>
                        <input asp-for="Password" class="form-control" type="password" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="ConfirmPassword">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group full">
                        <label class="form-label" asp-for="ProfilePhoto">Profile Photo *</label>
                        <input asp-for="ProfilePhoto" class="form-control" type="file" accept="image/*" required />
                        <span asp-validation-for="ProfilePhoto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="PhoneNumber">Phone *</label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Specialization">Specialization *</label>
                        <input asp-for="Specialization" class="form-control" placeholder="e.g. Bovine Medicine" required />
                        <span asp-validation-for="Specialization" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="ConsultationFee">Consultation Fee *</label>
                        <input asp-for="ConsultationFee" class="form-control" type="number" step="0.01" min="0.01" required />
                        <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="YearsOfExperience">Years of Experience *</label>
                        <input asp-for="YearsOfExperience" class="form-control" type="number" min="0" max="60" required />
                        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                    </div>
                    <div class="form-group full">
                        <label class="form-label" asp-for="AvailableTimeSlot">Available Time Slots *</label>
                        <input asp-for="AvailableTimeSlot" class="form-control" placeholder="e.g. Mon-Fri 9am-5pm" required />
                        <span asp-validation-for="AvailableTimeSlot" class="text-danger"></span>
                    </div>
                    <div class="form-group full">
                        <label class="form-label" asp-for="LicenseNumber">License / Certificate Number (optional)</label>
                        <input asp-for="LicenseNumber" class="form-control" placeholder="VET-XXXX" />
                    </div>
                </div>
                <button type="submit" class="btn-primary"><i class="bi bi-person-plus"></i> Create Veterinarian Account</button>
            </form>
            <div class="footer">
                Already have an account? <a href="/Account/Login">Sign in</a>
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
