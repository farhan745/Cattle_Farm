@model IEnumerable<CattleFarm.Models.Doctor>
@{
    ViewData["Title"] = "Veterinarians";
    var search = ViewData["Search"] as string;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
    <div>
        <h1 class="page-title">Veterinarians</h1>
        <p class="page-subtitle">Approved veterinarians on the platform — browse profiles and book appointments (@Model.Count() available)</p>
    </div>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a href="/Account/Register?role=Doctor" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Register as Veterinarian
        </a>
    }
    else if (User.IsInRole("Doctor"))
    {
        <a href="/Doctor/Edit" class="btn btn-outline">
            <i class="bi bi-pencil"></i> Edit my profile
        </a>
    }
</div>

<div class="card" style="margin-bottom: 24px;">
    <div class="card-body" style="padding: 16px 20px;">
        <form method="get" action="/Doctor" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <div style="position: relative; flex-grow: 1; min-width: 200px;">
                <i class="bi bi-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #6B6B66;"></i>
                <input type="text" name="search" value="@search" placeholder="Search by name, specialization..." class="form-control" style="padding-left: 40px; width: 100%;" />
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a href="/Doctor" class="btn btn-outline">Clear</a>
            }
        </form>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
    @foreach (var d in Model)
    {
        <div class="card" style="display: flex; flex-direction: column; height: 100%; border: 1px solid #E8E0D4; border-radius: 16px;">
            <div style="padding: 24px; text-align: center; background: linear-gradient(135deg, #F1F6F2, #FAF8F4); border-bottom: 1px solid #E8E0D4;">
                @if (!string.IsNullOrEmpty(d.ImagePath))
                {
                    <img src="@d.ImagePath" style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid #2D5A3D; margin: 0 auto 12px; display: block;" alt="Dr. @d.FullName" />
                }
                else
                {
                    <div style="width: 90px; height: 90px; border-radius: 50%; background: #D5E7D7; display: flex; align-items: center; justify-content: center; font-size: 38px; margin: 0 auto 12px; color: #2D5A3D; border: 3px solid #2D5A3D;"></div>
                }
                <div style="font-size: 17px; font-weight: 800; color: #1C3A2A;">Dr. @d.FullName</div>
                <div style="font-size: 13.5px; color: #2D5A3D; font-weight: 700; margin-top: 4px;">@d.Specialization</div>
                <div style="margin-top: 8px;">
                    <span class="badge @(d.IsAvailable ? "badge-success" : "badge-gray")">@(d.IsAvailable ? "Available" : "Busy")</span>
                </div>
            </div>
            <div style="padding: 20px; flex-grow: 1; font-size: 13px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <div style="color: #6B6B66; font-size: 11px; font-weight: 600; text-transform: uppercase;">Experience</div>
                        <div style="font-weight: 700;">@(d.YearsOfExperience > 0 ? $"{d.YearsOfExperience} years" : "—")</div>
                    </div>
                    <div>
                        <div style="color: #6B6B66; font-size: 11px; font-weight: 600; text-transform: uppercase;">Fee</div>
                        <div style="font-weight: 700; color: #2D5A3D;">@Currency.Format(d.ConsultationFee)</div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div style="color: #6B6B66; font-size: 11px; font-weight: 600; text-transform: uppercase;">Availability</div>
                        <div style="font-weight: 700;">@(d.AvailableTimeSlot ?? "Contact for schedule")</div>
                    </div>
                </div>
            </div>
            <div style="padding: 16px 20px; background: #FAF8F4; border-top: 1px solid #E8E0D4; display: flex; justify-content: space-between; gap: 8px;">
                <a href="/Appointment/Create?doctorId=@d.Id" class="btn btn-primary btn-sm"><i class="bi bi-calendar-plus"></i> Book</a>
                <a href="/Doctor/Details/@d.Id" class="btn btn-outline btn-sm">Profile</a>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div style="text-align: center; padding: 60px 40px; border: 1px dashed #DDD5C8; border-radius: 16px; background: #FAF8F4;">
        <div style="font-size: 48px; margin-bottom: 16px;"></div>
        <h3 style="font-size: 18px; font-weight: 700; color: #1C3A2A; margin-bottom: 6px;">No veterinarians yet</h3>
        <p style="color: #6B6B66; font-size: 14px; margin-bottom: 20px;">Doctors join by self-registration. Share the sign-up link with veterinarians.</p>
        <a href="/Account/Register?role=Doctor" class="btn btn-primary">Register as Veterinarian</a>
    </div>
}

@if (totalPages > 1)
{
    <div style="display: flex; justify-content: center; gap: 12px; margin-top: 32px;">
        @if (currentPage > 1)
        {
            <a href="@Url.Action("Index", new { page = currentPage - 1, search })" class="btn btn-outline">Previous</a>
        }
        <span style="align-self: center; font-size: 14px; color: #6B6B66;">Page @currentPage of @totalPages</span>
        @if (currentPage < totalPages)
        {
            <a href="@Url.Action("Index", new { page = currentPage + 1, search })" class="btn btn-outline">Next</a>
        }
    </div>
}
