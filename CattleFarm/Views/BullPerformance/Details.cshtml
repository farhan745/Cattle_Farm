@model CattleFarm.Models.BullPerformanceRecord
@{
    ViewData["Title"] = $"Evaluation Details - {Model.Cattle?.Name}";
    var gradeBadge = Model.QualityGrade switch
    {
        SemenQuality.Excellent => "bg-success text-white",
        SemenQuality.Good => "bg-info text-white",
        SemenQuality.Fair => "bg-warning text-dark",
        _ => "bg-danger text-white"
    };
}

<div class="page-header animate-fade-in">
    <div>
        <h1 class="page-title text-gradient"><i class="bi bi-shield-check"></i> Semen Quality Evaluation</h1>
        <p class="page-subtitle">Detailed semen quality analysis and performance log for bull <strong>@Model.Cattle?.Name</strong></p>
    </div>
    <div style="display: flex; gap: 8px;">
        <a href="/BullPerformance" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to List</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("Manager"))
        {
            <a href="/BullPerformance/Edit/@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit Record</a>
        }
    </div>
</div>

<div class="row animate-slide-up" style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- Evaluation Metrics -->
    <div class="card glass-card">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-clipboard2-pulse-fill text-primary"></i> Analysis Results</h3>
        </div>
        <div class="card-body">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                <div class="metric-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; text-align: center;">
                    <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Semen Motility</div>
                    <div style="font-size: 32px; font-weight: 700; margin-top: 8px; color: var(--success);">
                        @(Model.MotilityPercent.HasValue ? $"{Model.MotilityPercent.Value:N1}%" : "N/A")
                    </div>
                </div>

                <div class="metric-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; text-align: center;">
                    <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Normal Morphology</div>
                    <div style="font-size: 32px; font-weight: 700; margin-top: 8px; color: var(--success);">
                        @(Model.MorphologyPercent.HasValue ? $"{Model.MorphologyPercent.Value:N1}%" : "N/A")
                    </div>
                </div>

                <div class="metric-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; text-align: center;">
                    <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Concentration</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 8px;" class="text-primary">
                        @(Model.ConcentrationMillionPerMl.HasValue ? $"{Model.ConcentrationMillionPerMl.Value:N0} M/mL" : "N/A")
                    </div>
                </div>

                <div class="metric-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; text-align: center;">
                    <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Sample Volume</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 8px;" class="text-primary">
                        @(Model.VolumeML.HasValue ? $"{Model.VolumeML.Value:N1} mL" : "N/A")
                    </div>
                </div>
            </div>

            <hr style="border-color: var(--border); margin: 20px 0;" />

            <div class="detail-group">
                <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 12px;">Evaluation Notes & Observations</h4>
                @if (string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p style="color: var(--text-muted); font-style: italic;">No specific observations recorded for this evaluation.</p>
                }
                else
                {
                    <p style="white-space: pre-wrap; line-height: 1.5;">@Model.Notes</p>
                }
            </div>
        </div>
    </div>

    <!-- Metadata Panel -->
    <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card glass-card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-info-circle-fill text-info"></i> Bull Profile & Metadata</h3>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: 12px;">
                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Bull</span>
                    <a href="/Cattle/Details/@Model.CattleId" class="fw-bold" style="font-size: 16px; text-decoration: none;">
                        <i class="bi bi-gender-female"></i> @Model.Cattle?.Name (@Model.Cattle?.TagId)
                    </a>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Quality Grade</span>
                    <span class="badge @gradeBadge" style="font-size: 13px; padding: 6px 12px; margin-top: 4px;">
                        @Model.QualityGrade
                    </span>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Evaluation Date</span>
                    <span class="fw-semibold">@Model.EvaluationDate.ToString("MMMM dd, yyyy")</span>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Farm / Facility</span>
                    <span>@Model.Farm?.Name</span>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Evaluator / Veterinarian</span>
                    <span class="fw-semibold">@Model.EvaluatedBy</span>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Cost of Evaluation</span>
                    <span class="fw-semibold">@(Model.Cost.HasValue ? $"BDT {Model.Cost.Value:N2}" : "N/A")</span>
                </div>

                <div>
                    <span style="font-size: 12px; color: var(--text-muted); display: block;">Recorded At</span>
                    <span style="font-size: 12px; color: var(--text-muted);">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
</div>
