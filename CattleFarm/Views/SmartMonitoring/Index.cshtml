@model IEnumerable<CattleFarm.Models.SensorReading>
@using CattleFarm.Models
@{
    ViewData["Title"] = "Smart Monitoring";
    var farms = ViewBag.Farms as IEnumerable<Farm> ?? Enumerable.Empty<Farm>();
    var selectedFarm = ViewBag.SelectedFarm as Farm;
    var latestGps = ViewBag.LatestGps as IEnumerable<GpsTrackerSnapshot> ?? Enumerable.Empty<GpsTrackerSnapshot>();
    var commands = ViewBag.FeedingCommands as IEnumerable<AutomatedFeedingCommand> ?? Enumerable.Empty<AutomatedFeedingCommand>();
    var imports = ViewBag.MilkImports as IEnumerable<MilkMachineImport> ?? Enumerable.Empty<MilkMachineImport>();
    var pendingSync = ViewBag.PendingSync as int? ?? 0;
}

<div class="page-header animate-fade-in">
    <div>
        <h1 class="page-title text-gradient"><i class="bi bi-broadcast" style="color:var(--primary)"></i> Smart Monitoring</h1>
        <p class="page-subtitle">Barn conditions, automated feeders, milk imports, and real-time SignalR IoT tracking</p>
    </div>
    <div style="display:flex;gap:12px;align-items:center">
        <!-- Live Connection status -->
        <div id="connStatus" style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;padding:6px 12px;border-radius:30px;background:rgba(239,68,68,0.08);color:var(--danger)">
            <span class="pulse-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor"></span>
            <span id="connStatusText">Offline</span>
        </div>

        @if (farms.Any())
        {
            <form method="get" action="/SmartMonitoring" style="margin:0">
                <select name="farmId" class="form-control" onchange="this.form.submit()" style="width:200px">
                    @foreach (var farm in farms)
                    {
                        if (selectedFarm?.Id == farm.Id)
                        {
                            <option value="@farm.Id" selected="selected">@farm.Name</option>
                        }
                        else
                        {
                            <option value="@farm.Id">@farm.Name</option>
                        }
                    }
                </select>
            </form>
        }
    </div>
</div>

@if (selectedFarm is null)
{
    <div class="card">
        <div class="card-body" style="text-align:center;padding:60px 20px">
            <i class="bi bi-wifi-off" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px"></i>
            <h3 style="font-weight:700;margin-bottom:8px">No farm selected or accessible</h3>
            <p style="color:var(--text-muted)">Ensure you have registered or joined a farm to display smart telemetry.</p>
        </div>
    </div>
}
else
{
    <!-- KPIs -->
    <div class="stat-grid animate-fade-in" id="smartSummary" data-farm-id="@selectedFarm.Id" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px">
        <div class="stat-card blue">
            <div class="stat-icon blue"><i class="bi bi-thermometer-half"></i></div>
            <div>
                <div class="stat-value" id="summary-temp">--</div>
                <div class="stat-label">Barn Temperature</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon green"><i class="bi bi-moisture"></i></div>
            <div>
                <div class="stat-value" id="summary-humidity">--</div>
                <div class="stat-label">Tank Humidity</div>
            </div>
        </div>
        <div class="stat-card amber">
            <div class="stat-icon amber"><i class="bi bi-geo-alt"></i></div>
            <div>
                <div class="stat-value" id="summary-gps">@latestGps.Select(g => g.TrackerId).Distinct().Count()</div>
                <div class="stat-label">GPS Trackers</div>
            </div>
        </div>
        <div class="stat-card purple">
            <div class="stat-icon purple"><i class="bi bi-cloud-arrow-up"></i></div>
            <div>
                <div class="stat-value" id="summary-sync">@pendingSync</div>
                <div class="stat-label">Offline Sync queue</div>
            </div>
        </div>
    </div>

    <!-- Live Telemetry Graph & Cattle Tracker -->
    <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:24px;margin-bottom:24px" class="animate-fade-in">
        <!-- Live Sensors Chart -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-cpu"></i> Live Environmental Sensor Stream</h3>
            </div>
            <div class="card-body">
                <div style="height:250px;position:relative">
                    <canvas id="liveSensorsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- GPS Cattle Tracker Map -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-compass"></i> Live Pasture Coordinates Map</h3>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
                <div style="position:relative;height:210px;background:#f1f5f9;border-radius:12px;overflow:hidden;border:1px solid var(--border)">
                    <!-- Grid pasture background -->
                    <svg style="position:absolute;width:100%;height:100%;top:0;left:0">
                        <defs>
                            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0,0,0,0.04)" stroke-width="1"/>
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid)" />
                        <!-- Pasture A boundary -->
                        <rect x="20" y="20" width="130" height="70" rx="8" fill="rgba(34,197,94,0.1)" stroke="rgba(34,197,94,0.25)" stroke-width="1.5" stroke-dasharray="3,3" />
                        <text x="30" y="38" fill="var(--primary)" font-size="10" font-weight="700">Pasture A (Milking cows)</text>
                        
                        <!-- Pasture B boundary -->
                        <rect x="180" y="90" width="150" height="90" rx="8" fill="rgba(59,130,246,0.1)" stroke="rgba(59,130,246,0.25)" stroke-width="1.5" stroke-dasharray="3,3" />
                        <text x="190" y="108" fill="#1d4ed8" font-size="10" font-weight="700">Pasture B (Dry/Heifers)</text>
                    </svg>

                    <!-- GPS coordinate pin -->
                    <div id="gpsMarker" style="position:absolute;width:14px;height:14px;border-radius:50%;background:#ef4444;border:2.5px solid #fff;box-shadow:0 0 8px rgba(239,68,68,0.7);transition:all 2s ease-in-out;left:40%;top:40%">
                        <span style="position:absolute;width:28px;height:28px;border-radius:50%;border:2px solid rgba(239,68,68,0.4);left:-9.5px;top:-9.5px" class="glow-pulse"></span>
                    </div>
                </div>
                <div style="font-size:12px;color:var(--text-secondary);text-align:center" id="gpsCoords">
                    No GPS readings plotted yet. Select a tracker to simulate paths.
                </div>
            </div>
        </div>
    </div>

    <!-- Data lists -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px" class="animate-fade-in">
        <!-- Sensor Logs -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Latest Sensor Logs</h3></div>
            <div class="card-body" style="padding:0">
                <div class="table-wrapper" style="border:none;max-height:280px;overflow-y:auto">
                    <table class="data-table" id="sensorTable">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Type</th>
                                <th>Value</th>
                                <th>Zone</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Take(10))
                            {
                                <tr>
                                    <td><strong>@r.DeviceId</strong></td>
                                    <td>@r.ReadingType</td>
                                    <td>@r.Value.ToString("F1") @r.Unit</td>
                                    <td>@(r.BarnZone ?? "Main")</td>
                                    <td>@r.RecordedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Milk Machine telemetry -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Milk Machine Imports</h3></div>
            <div class="card-body" style="padding:0">
                <div class="table-wrapper" style="border:none;max-height:280px;overflow-y:auto">
                    <table class="data-table" id="milkImportTable">
                        <thead>
                            <tr>
                                <th>Machine</th>
                                <th>Cattle</th>
                                <th>Yield</th>
                                <th>Quality (Fat/Prot)</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in imports.Take(10))
                            {
                                <tr>
                                    <td><strong>@r.MachineId</strong></td>
                                    <td>@r.Cattle?.Name (@r.Cattle?.TagId)</td>
                                    <td style="font-weight:700;color:var(--primary)">@r.YieldLiters.ToString("F1") L</td>
                                    <td>@($"{r.FatPercentage ?? 0}% / {r.ProteinPercentage ?? 0}%")</td>
                                    <td>@r.CollectedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

   
}

@section Scripts {
@if (selectedFarm != null)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const maxDataPoints = 12;
        const sensorLabels = [];
        const tempValues = [];
        const humidityValues = [];

        // Prepopulate chart labels
        for (let i = maxDataPoints - 1; i >= 0; i--) {
            const timeStr = new Date(Date.now() - i * 60000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            sensorLabels.push(timeStr);
            tempValues.push(null);
            humidityValues.push(null);
        }

        // Initialize Live Chart
        const ctx = document.getElementById('liveSensorsChart').getContext('2d');
        const liveChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: sensorLabels,
                datasets: [
                    {
                        label: 'Temperature (°C)',
                        data: tempValues,
                        borderColor: '#ef4444',
                        backgroundColor: 'rgba(239,68,68,0.05)',
                        borderWidth: 2,
                        tension: 0.35,
                        fill: true
                    },
                    {
                        label: 'Humidity (%)',
                        data: humidityValues,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.05)',
                        borderWidth: 2,
                        tension: 0.35,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    y: { beginAtZero: false }
                }
            }
        });

        // Setup SignalR Connection
        const farmId = @selectedFarm.Id;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/farm-dashboard")
            .withAutomaticReconnect()
            .build();

        // Bind events
        connection.on("ReceiveSensorReading", function (reading) {
            console.log("Sensor reading received:", reading);
            
            // Append to table
            const table = document.getElementById('sensorTable').getElementsByTagName('tbody')[0];
            const newRow = table.insertRow(0);
            newRow.classList.add('animate-fade-in');
            
            newRow.innerHTML = `
                <td><strong>${escapeHtml(reading.deviceId)}</strong></td>
                <td>${escapeHtml(reading.readingType)}</td>
                <td>${Number(reading.value).toFixed(1)} ${escapeHtml(reading.unit)}</td>
                <td>${escapeHtml(reading.barnZone || 'Main')}</td>
                <td>${new Date(reading.recordedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</td>
            `;
            if (table.rows.length > 10) table.deleteRow(table.rows.length - 1);

            // Update stats cards
            if (reading.readingType === "Temperature") {
                document.getElementById('summary-temp').textContent = `${Number(reading.value).toFixed(1)} °C`;
                // Add to chart
                updateChartData(reading.recordedAt, Number(reading.value), null);
            } else if (reading.readingType === "Humidity") {
                document.getElementById('summary-humidity').textContent = `${Number(reading.value).toFixed(1)} %`;
                // Add to chart
                updateChartData(reading.recordedAt, null, Number(reading.value));
            }
        });

        connection.on("ReceiveGpsSnapshot", function (gps) {
            console.log("GPS reading received:", gps);
            
            // Map coordinates mapping simulation within bounding box
            // Scale latitude/longitude to pasture map percentage coordinates (pasture values inside pasture bounds)
            // Normal range: lat [23.0 to 24.5], lon [89.0 to 91.0]
            const minLat = 23.0; const maxLat = 24.5;
            const minLon = 89.0; const maxLon = 91.0;
            
            let pctLeft = ((gps.longitude - minLon) / (maxLon - minLon)) * 100;
            let pctTop = (1 - (gps.latitude - minLat) / (maxLat - minLat)) * 100;
            
            // Boundary constraints inside pasture bounds
            pctLeft = Math.max(10, Math.min(90, pctLeft));
            pctTop = Math.max(10, Math.min(90, pctTop));
            
            // Move marker
            const marker = document.getElementById('gpsMarker');
            if (marker) {
                marker.style.left = pctLeft + '%';
                marker.style.top = pctTop + '%';
            }
            
            document.getElementById('gpsCoords').innerHTML = 
                `Live GPS Pin: <strong style="color:var(--danger)">${gps.trackerId}</strong> is at ${gps.latitude.toFixed(6)}, ${gps.longitude.toFixed(6)} (${gps.speedKph.toFixed(1)} km/h)`;
        });

        connection.on("ReceiveMilkMachineReading", function (reading) {
            // Append to table
            const table = document.getElementById('milkImportTable').getElementsByTagName('tbody')[0];
            const newRow = table.insertRow(0);
            newRow.classList.add('animate-fade-in');
            
            newRow.innerHTML = `
                <td><strong>${escapeHtml(reading.machineId)}</strong></td>
                <td>Cattle ID: ${reading.cattleId || '-'}</td>
                <td style="font-weight:700;color:var(--primary)">${Number(reading.yieldLiters).toFixed(1)} L</td>
                <td>${Number(reading.fatPercentage || 0).toFixed(2)}% fat / ${Number(reading.proteinPercentage || 0).toFixed(2)}% prot</td>
                <td>${new Date(reading.collectedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</td>
            `;
            if (table.rows.length > 10) table.deleteRow(table.rows.length - 1);
        });

        // Connection events
        connection.onclose(onOffline);
        connection.onreconnecting(onOffline);
        connection.onreconnected(onOnline);

        async function startSignalR() {
            try {
                await connection.start();
                await connection.invoke("JoinFarmGroup", farmId);
                onOnline();
            } catch (err) {
                console.error("SignalR Connection failed: ", err);
                onOffline();
                setTimeout(startSignalR, 5000);
            }
        }

        function onOnline() {
            const el = document.getElementById('connStatus');
            el.style.background = 'rgba(34,197,94,0.08)';
            el.style.color = 'var(--success)';
            document.getElementById('connStatusText').textContent = 'SignalR Connected';
        }

        function onOffline() {
            const el = document.getElementById('connStatus');
            el.style.background = 'rgba(239,68,68,0.08)';
            el.style.color = 'var(--danger)';
            document.getElementById('connStatusText').textContent = 'Reconnecting...';
        }

        function updateChartData(recordedAt, temp, humidity) {
            const timeStr = new Date(recordedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            
            // Shift datasets
            liveChart.data.labels.shift();
            liveChart.data.labels.push(timeStr);
            
            if (temp !== null) {
                liveChart.data.datasets[0].data.shift();
                liveChart.data.datasets[0].data.push(temp);
                // Keep humidity data point matching index structure
                liveChart.data.datasets[1].data.shift();
                liveChart.data.datasets[1].data.push(liveChart.data.datasets[1].data[liveChart.data.datasets[1].data.length - 1] || null);
            } else if (humidity !== null) {
                liveChart.data.datasets[1].data.shift();
                liveChart.data.datasets[1].data.push(humidity);
                // Keep temp data point matching index structure
                liveChart.data.datasets[0].data.shift();
                liveChart.data.datasets[0].data.push(liveChart.data.datasets[0].data[liveChart.data.datasets[0].data.length - 1] || null);
            }
            
            liveChart.update('none');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // IoT Simulator Functions
        function addSimLog(msg, isError = false) {
            const log = document.getElementById('simLog');
            const time = new Date().toLocaleTimeString();
            log.innerHTML = `<span style="color:${isError ? 'var(--danger)' : 'var(--success)'}">[${time}] ${escapeHtml(msg)}</span><br/>` + log.innerHTML;
        }

        window.simulateSensor = function(type) {
            const val = type === 'Temperature' 
                ? (Math.random() * (38 - 22) + 22).toFixed(1)
                : (Math.random() * (95 - 55) + 55).toFixed(1);
            const unit = type === 'Temperature' ? '°C' : '%';
            
            const payload = {
                farmId: farmId,
                deviceId: `SIM-ENV-${type.toUpperCase()}-01`,
                readingType: type,
                value: parseFloat(val),
                unit: unit,
                barnZone: 'Main Barn Section A'
            };

            addSimLog(`Posting ${type} of ${val}${unit}...`);

            fetch('/api/smart-monitoring/sensor-readings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (res.ok) addSimLog(`Success: Recorded ${type} = ${val}${unit}`);
                else res.text().then(t => addSimLog(`Error: ${t}`, true));
            })
            .catch(err => addSimLog(`Error: ${err.message}`, true));
        }

        window.simulateGps = function() {
            // Fetch a random cattle ID from the current farm
            fetch('/Cattle/ByFarm?farmId=' + farmId)
            .then(res => res.json())
            .then(cattleList => {
                const cattle = cattleList && cattleList.length > 0
                    ? cattleList[Math.floor(Math.random() * cattleList.length)]
                    : null;
                
                const cattleId = cattle ? cattle.id : null;
                const cattleName = cattle ? cattle.name : 'Unknown';

                // Random coordinate in bounds: lat [23.1 to 24.4], lon [89.1 to 90.9]
                const lat = Math.random() * (24.4 - 23.1) + 23.1;
                const lon = Math.random() * (90.9 - 89.1) + 89.1;
                const speed = Math.random() * 8; // 0 to 8 kph
                
                const payload = {
                    farmId: farmId,
                    cattleId: cattleId,
                    trackerId: `GPS-COLLAR-${cattle ? cattle.tagId : 'MOCK'}`,
                    latitude: lat,
                    longitude: lon,
                    speedKph: speed
                };

                addSimLog(`Posting GPS for Cattle: ${cattleName}...`);

                return fetch('/api/smart-monitoring/gps', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            })
            .then(res => {
                if (res.ok) addSimLog(`Success: Updated GPS coordinate`);
                else res.text().then(t => addSimLog(`Error: ${t}`, true));
            })
            .catch(err => addSimLog(`Error: ${err.message}`, true));
        }

        window.simulateMilkMachine = function() {
            fetch('/Cattle/ByFarm?farmId=' + farmId + '&gender=Female')
            .then(res => res.json())
            .then(cattleList => {
                const cattle = cattleList && cattleList.length > 0
                    ? cattleList[Math.floor(Math.random() * cattleList.length)]
                    : null;
                
                if (!cattle) {
                    addSimLog("Error: No female cattle found on this farm to simulate milk collection.", true);
                    return;
                }

                const yieldLiters = (Math.random() * (24 - 8) + 8).toFixed(1);
                const fat = (Math.random() * (5.5 - 3.2) + 3.2).toFixed(2);
                const protein = (Math.random() * (4.2 - 2.8) + 2.8).toFixed(2);

                const payload = {
                    farmId: farmId,
                    cattleId: cattle.id,
                    machineId: 'AUTO-MILKER-03',
                    yieldLiters: parseFloat(yieldLiters),
                    fatPercentage: parseFloat(fat),
                    proteinPercentage: parseFloat(protein)
                };

                addSimLog(`Posting Milk Yield for Cow: ${cattle.name} (${yieldLiters} L)...`);

                fetch('/api/smart-monitoring/milk-machine-imports', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(res => {
                    if (res.ok) addSimLog(`Success: Recorded milk yield ${yieldLiters} L for ${cattle.name}`);
                    else res.text().then(t => addSimLog(`Error: ${t}`, true));
                });
            })
            .catch(err => addSimLog(`Error: ${err.message}`, true));
        }

        // Start SignalR on load
        window.addEventListener('DOMContentLoaded', startSignalR);
    </script>
}
}
