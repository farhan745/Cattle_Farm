@model IEnumerable<CattleFarm.Models.MilkProduction>
@{
    ViewData["Title"] = "Milk Production";
    double totalToday  = (double)(ViewData["TotalToday"]  ?? 0.0);
    double totalMonth  = (double)(ViewData["TotalMonth"]  ?? 0.0);
    int    currentPage = (int)(ViewData["CurrentPage"]    ?? 1);
    int    totalPages  = (int)(ViewData["TotalPages"]     ?? 1);
}

<div class="page-header animate-fade-in">
    <div><h1 class="page-title text-gradient"> Milk Production</h1><p class="page-subtitle">Daily yield tracking and production analytics</p></div>
    <div class="page-actions" style="display:flex; gap:8px;">
        <a href="/MilkProduction/TopProducers" class="btn btn-outline-success"><i class="bi bi-trophy"></i> Top Producers</a>
        <a href="/MilkProduction/DropAlerts" class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle"></i> Drop Alerts</a>
        @if ((int)(ViewBag.FarmId ?? 0) > 0)
        {
            <a asp-action="ExportExcel" asp-route-farmId="@ViewBag.FarmId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-outline">
                <i class="bi bi-file-earmark-spreadsheet"></i> Export Excel
            </a>
        }
        <a href="/MilkProduction/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Log Yield</a>
    </div>
</div>

<!-- KPIs -->
<div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:20px">
    <div class="stat-card blue">
        <div class="stat-icon blue"></div>
        <div><div class="stat-value">@totalToday.ToString("F1")<span style="font-size:14px;font-weight:400">L</span></div><div class="stat-label">Today's Total Yield</div></div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon green"></div>
        <div><div class="stat-value">@totalMonth.ToString("F0")<span style="font-size:14px;font-weight:400">L</span></div><div class="stat-label">This Month's Total</div></div>
    </div>
    <div class="stat-card amber">
        <div class="stat-icon amber"></div>
        <div><div class="stat-value">@(Model.Any() ? (Model.Average(m => m.MorningYieldLiters + m.EveningYieldLiters)).ToString("F1") : "0.0")<span style="font-size:14px;font-weight:400">L</span></div><div class="stat-label">Avg Per Record</div></div>
    </div>
</div>



<!-- Chart -->
<div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3 class="card-title">Production Trend (Last 14 Days)</h3></div>
    <div class="card-body"><div class="chart-container" style="height:220px"><canvas id="milkTrendChart"></canvas></div></div>
</div>

<!-- Log Form + Table -->
<div style="display:grid;grid-template-columns:320px 1fr;gap:20px;align-items:start">
    <!-- Quick Log -->
    <div class="card">
        <div class="card-header"><h3 class="card-title">Quick Log</h3></div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Cattle</label>
                    <select name="CattleId" class="form-control" required>
                        <option value="">Select cattle...</option>
                        @foreach (var c in (IEnumerable<CattleFarm.Models.Cattle>)ViewBag.Cattles)
                        { <option value="@c.Id">@c.Name (@c.TagId)</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Farm</label>
                    <select name="FarmId" class="form-control" required>
                        <option value="">Select farm...</option>
                        @foreach (var f in (IEnumerable<CattleFarm.Models.Farm>)ViewBag.Farms)
                        { <option value="@f.Id">@f.Name</option> }
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Date</label><input name="Date" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                    <div class="form-group"><label class="form-label">Morning (L)</label><input name="MorningYieldLiters" class="form-control" type="number" step="0.1" placeholder="0.0" /></div>
                    <div class="form-group"><label class="form-label">Evening (L)</label><input name="EveningYieldLiters" class="form-control" type="number" step="0.1" placeholder="0.0" /></div>
                </div>
                <div class="form-group"><label class="form-label">Notes</label><input name="Notes" class="form-control" placeholder="Optional notes..." /></div>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-circle"></i> Log Yield</button>
            </form>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card" style="flex:1">
        <div class="card-header"><h3 class="card-title">Production Records</h3></div>
        <div class="card-body" style="padding:0">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Cattle</th>
                            <th>Date</th>
                            <th>Morning</th>
                            <th>Evening</th>
                            <th>Total Yield</th>
                            <th>Quality (Fat/Prot/SNF)</th>
                            <th>Grade</th>
                            <th>Notes</th>
                            <th style="text-align:center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" style="text-align:center;padding:48px 20px;color:var(--text-muted)">
                                    <i class="bi bi-droplet" style="font-size:36px;display:block;margin-bottom:8px"></i>
                                    No milk production records found for the filter criteria.
                                </td>
                            </tr>
                        }
                        @foreach (var r in Model)
                        {
                            var qualityStr = r.FatPercentage.HasValue || r.ProteinLevel.HasValue || r.SolidNotFat.HasValue
                                ? $"{r.FatPercentage ?? 0}% / {r.ProteinLevel ?? 0}% / {r.SolidNotFat ?? 0}%"
                                : "N/A";
                            var gradeClass = r.MilkQualityGrade == "A" ? "badge-success" : (r.MilkQualityGrade == "B" ? "badge-warning" : "badge-danger");
                            
                            <tr>
                                <td>
                                    <strong>@r.Cattle?.Name</strong>
                                    <span style="font-size:11px;color:var(--text-muted);display:block">@r.Cattle?.TagId</span>
                                </td>
                                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                <td>@r.MorningYieldLiters.ToString("F1") L</td>
                                <td>@r.EveningYieldLiters.ToString("F1") L</td>
                                <td style="font-weight:700">@r.TotalYieldLiters.ToString("F1") L</td>
                                <td>@qualityStr</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.MilkQualityGrade))
                                    {
                                        <span class="badge @gradeClass">Grade @r.MilkQualityGrade</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-gray">N/A</span>
                                    }
                                </td>
                                <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@r.Notes">@r.Notes</td>
                                <td style="text-align:center">
                                    <div style="display:flex;gap:6px;justify-content:center">
                                        <form method="post" asp-action="Delete" asp-route-id="@r.Id" asp-route-farmId="@r.FarmId" onsubmit="return confirm('Are you sure you want to delete this log?');" style="margin:0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" style="padding:4px 8px" title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination" style="padding:16px 20px;border-top:1px solid var(--border)">
                    @if (currentPage > 1)
                    {
                        <a href="?farmId=@ViewBag.FarmId&from=@ViewBag.From&to=@ViewBag.To&page=@(currentPage-1)" class="page-link"><i class="bi bi-chevron-left"></i></a>
                    }
                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <a href="?farmId=@ViewBag.FarmId&from=@ViewBag.From&to=@ViewBag.To&page=@i" class="page-link @(i == currentPage ? "active" : "")">@i</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="?farmId=@ViewBag.FarmId&from=@ViewBag.From&to=@ViewBag.To&page=@(currentPage+1)" class="page-link"><i class="bi bi-chevron-right"></i></a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
const mlabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<string>)ViewBag.TrendDates)));
const mdata   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<double>)ViewBag.TrendYields)));
new Chart(document.getElementById('milkTrendChart'), {
    type: 'bar',
    data: { labels: mlabels, datasets: [{ label: 'Yield (L)', data: mdata, backgroundColor: 'rgba(59,130,246,.7)', borderRadius: 4 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true }, x: { grid: { display: false } } } }
});
</script>
}
