@model CattleFarm.ViewModels.CattleMedicalRecordViewModel
@{
    ViewData["Title"] = "Log Examination";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Log Examination</h1>
        <p class="page-subtitle">@Model.CattleName (@Model.CattleTagId)</p>
    </div>
    <a href="/Cattle/Details/@Model.CattleId" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to Cattle</a>
</div>

<div style="max-width:800px;margin:0 auto">
    <form asp-action="AddMedicalRecord" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CattleId" />
        <div class="card">
            <div class="card-header"><h3 class="card-title">Examination Details</h3></div>
            <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="grid-column:1/-1"></div>
                <div class="form-group">
                    <label class="form-label">Examination Date *</label>
                    <input asp-for="ExaminationDate" class="form-control" type="date" />
                    <span asp-validation-for="ExaminationDate" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Next Visit Date</label>
                    <input asp-for="NextVisitDate" class="form-control" type="date" />
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Chief Complaint / Symptoms *</label>
                    <textarea asp-for="ChiefComplaint" class="form-control" rows="2" required></textarea>
                    <span asp-validation-for="ChiefComplaint" class="form-error"></span>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Diagnosis *</label>
                    <textarea asp-for="Diagnosis" class="form-control" rows="2" required></textarea>
                    <span asp-validation-for="Diagnosis" class="form-error"></span>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Prescription / Treatment Plan</label>
                    <textarea asp-for="Prescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Medicine Name</label>
                    <input asp-for="MedicineName" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Medicine Dose</label>
                    <input asp-for="MedicineDose" class="form-control" placeholder="e.g. 500mg" />
                </div>
                <div class="form-group">
                    <label class="form-label">Dose Frequency</label>
                    <input asp-for="DoseFrequency" class="form-control" placeholder="e.g. Twice daily" />
                </div>
                <div class="form-group">
                    <label class="form-label">Duration (days)</label>
                    <input asp-for="DoseDurationDays" class="form-control" type="number" min="0" max="365" />
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Additional Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
                <div style="grid-column:1/-1">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Medical Record</button>
                </div>
            </div>
        </div>
    </form>
</div>
