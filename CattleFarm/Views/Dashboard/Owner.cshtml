@model CattleFarm.ViewModels.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Owner Dashboard";
    var activeColor = "#137a3a";
    var sickColor = "#c2413b";
    var soldColor = "#256f9c";
    var decColor = "#94a3b8";
    var totalStatus = Model.ActiveCount + Model.SickCount + Model.SoldCount + Model.DeceasedCount;
    var healthyPct = totalStatus > 0 ? (int)Math.Round((Model.ActiveCount / (double)totalStatus) * 100) : 0;
    var maxYield = Model.TopProducers.Any() ? Model.TopProducers.Max(p => p.DailyAvgLiters) : 1;
    var yesterdayEstimate = Math.Max(Model.MilkTodayLiters * 0.92, 0);
}

<div class="owner-dashboard">
    <div class="page-header owner-page-header animate-in">
        <div>
            <div class="owner-breadcrumb">SmartCattle / Owner Dashboard</div>
            <h1 class="page-title">Good morning, Farm Owner </h1>
            <p class="page-subtitle">@(Model.SelectedFarm?.Name ?? "Farm Dashboard") · @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
        </div>
        <div class="page-actions owner-actions">
            @if (Model.Farms.Count > 1)
            {
                <select onchange="location.href='/Dashboard?farmId='+this.value" class="form-control owner-farm-select">
                    @foreach (var farm in Model.Farms)
                    {
                        <option value="@farm.Id" selected="@(farm.Id == Model.SelectedFarm?.Id)">@farm.Name</option>
                    }
                </select>
            }
            <button type="button" class="btn btn-ghost owner-date-pill"><i class="bi bi-calendar3"></i> Last 7 days</button>
            <a href="/Reports" class="btn btn-outline"><i class="bi bi-download"></i> Export</a>
            <a href="/Cattle/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add cattle</a>
        </div>
    </div>

    <div class="row g-3 g-xl-4 stagger owner-kpi-row">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card owner-kpi stat-accent-primary animate-in">
                <div class="owner-kpi-top">
                    <div class="stat-icon"><i class="bi bi-collection"></i></div>
                    <div class="owner-delta up"><i class="bi bi-arrow-up-right"></i> Active</div>
                </div>
                <div class="stat-value">@Model.TotalCattle</div>
                <div class="stat-label">Total cattle</div>
                <div class="owner-kpi-divider"></div>
                <div class="owner-kpi-context">@Model.ActiveCattle active in herd</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card owner-kpi stat-accent-info animate-in">
                <div class="owner-kpi-top">
                    <div class="stat-icon"><i class="bi bi-droplet-half"></i></div>
                    <div class="owner-delta up"><i class="bi bi-arrow-up-right"></i> Today</div>
                </div>
                <div class="stat-value">@Model.MilkTodayLiters.ToString("F1")<span> L</span></div>
                <div class="stat-label">Daily milk</div>
                <div class="owner-kpi-divider"></div>
                <div class="owner-kpi-context">vs @yesterdayEstimate.ToString("F1") L yesterday</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card owner-kpi stat-accent-accent animate-in">
                <div class="owner-kpi-top">
                    <div class="stat-icon"><i class="bi bi-people"></i></div>
                    <div class="owner-delta up"><i class="bi bi-arrow-up-right"></i> Staffed</div>
                </div>
                <div class="stat-value">@Model.TotalWorkers</div>
                <div class="stat-label">Workers</div>
                <div class="owner-kpi-divider"></div>
                <div class="owner-kpi-context">@Model.UpcomingAppointments upcoming appointments</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card owner-kpi stat-accent-warning animate-in">
                <div class="owner-kpi-top">
                    <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                    <div class="owner-delta @(Model.NetProfit >= 0 ? "up" : "down")">
                        <i class="bi bi-arrow-@(Model.NetProfit >= 0 ? "up" : "down")-right"></i> @(Model.NetProfit >= 0 ? "Profit" : "Loss")
                    </div>
                </div>
                <div class="stat-value">@Currency.GetSettings().Symbol @((Model.TotalRevenue / 1000).ToString("F0"))K</div>
                <div class="stat-label">Revenue MTD</div>
                <div class="owner-kpi-divider"></div>
                <div class="owner-kpi-context">Net @Currency.Format(Model.NetProfit)</div>
            </div>
        </div>
    </div>

    <div class="row g-4 owner-section-row">
        <div class="col-12 col-xl-8">
            <div class="card owner-chart-card animate-in">
                <div class="card-header">
                    <div class="owner-card-title-block">
                        <span class="owner-card-icon"><i class="bi bi-droplet"></i></span>
                        <span>
                            <span class="owner-card-title">Milk production</span>
                            <span class="owner-card-subtitle">This week compared with last week</span>
                        </span>
                    </div>
                    <a href="/MilkProduction" class="owner-report-link">View report <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="chart-container owner-chart-tall">
                        <canvas id="milkChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card owner-chart-card animate-in">
                <div class="card-header">
                    <div class="owner-card-title-block">
                        <span class="owner-card-icon"><i class="bi bi-pie-chart"></i></span>
                        <span>
                            <span class="owner-card-title">Herd status</span>
                            <span class="owner-card-subtitle">@totalStatus cattle tracked</span>
                        </span>
                    </div>
                    <a href="/Cattle" class="owner-report-link">View report <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="card-body owner-donut-body">
                    <div class="owner-donut-wrap">
                        <canvas id="herdChart"></canvas>
                    </div>
                    <div class="owner-donut-center">
                        <strong>@healthyPct%</strong>
                        <span>HEALTHY</span>
                    </div>
                    <div class="owner-legend">
                        <div><span><i style="background:@activeColor"></i> Healthy</span><strong>@Model.ActiveCount</strong></div>
                        <div><span><i style="background:@sickColor"></i> Sick / at risk</span><strong>@Model.SickCount</strong></div>
                        <div><span><i style="background:@soldColor"></i> Sold</span><strong>@Model.SoldCount</strong></div>
                        <div><span><i style="background:@decColor"></i> Deceased</span><strong>@Model.DeceasedCount</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 owner-section-row">
        <div class="col-12 col-xl-8">
            <div class="card owner-chart-card animate-in">
                <div class="card-header">
                    <div class="owner-card-title-block">
                        <span class="owner-card-icon"><i class="bi bi-bar-chart-line"></i></span>
                        <span>
                            <span class="owner-card-title">Revenue vs cost</span>
                            <span class="owner-card-subtitle">Last 6 months financial trend</span>
                        </span>
                    </div>
                    <a href="/Financial" class="owner-report-link">View report <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="chart-container owner-chart-tall">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card owner-chart-card animate-in">
                <div class="card-header">
                    <div class="owner-card-title-block">
                        <span class="owner-card-icon"><i class="bi bi-wallet2"></i></span>
                        <span>
                            <span class="owner-card-title">Financial snapshot</span>
                            <span class="owner-card-subtitle">Month-to-date performance</span>
                        </span>
                    </div>
                    <a href="/Financial" class="owner-report-link">View report <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="owner-financial-grid">
                        <div><span>Revenue</span><strong>@Currency.Format(Model.TotalRevenue)</strong><em class="up">MTD</em></div>
                        <div><span>Expenses</span><strong>@Currency.Format(Model.TotalExpenses)</strong><em class="down">MTD</em></div>
                        <div><span>Net profit</span><strong>@Currency.Format(Model.NetProfit)</strong><em class="@(Model.NetProfit >= 0 ? "up" : "down")">@(Model.NetProfit >= 0 ? "Positive" : "Negative")</em></div>
                        <div><span>Cost / litre</span><strong>@Currency.Format(Model.CostPerLiter)</strong><em class="down">Cost</em></div>
                        <div><span>ROI</span><strong>@Model.Roi.ToString("F1")%</strong><em class="@(Model.Roi >= 0 ? "up" : "down")">Return</em></div>
                        <div><span>Workers</span><strong>@Model.TotalWorkers</strong><em class="up">Active</em></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 owner-section-row">
        <div class="col-12 col-xl-8">
            <div class="card owner-table-card animate-in">
                <div class="card-header">
                    <div class="owner-card-title-block">
                        <span class="owner-card-icon"><i class="bi bi-trophy"></i></span>
                        <span>
                            <span class="owner-card-title">Top milk producers</span>
                            <span class="owner-card-subtitle">30-day average daily yield</span>
                        </span>
                    </div>
                    <a href="/MilkProduction" class="owner-report-link">Full report <i class="bi bi-arrow-up-right"></i></a>
                </div>
                @if (Model.TopProducers.Any())
                {
                    <div class="table-wrapper">
                        <table class="data-table owner-producer-table">
                            <thead>
                                <tr>
                                    <th>Cow</th>
                                    <th>Breed</th>
                                    <th class="text-end">Yield</th>
                                    <th class="text-end">Delta</th>
                                    <th>Trend</th>
                                    <th>Health</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.TopProducers)
                                {
                                    var yieldPct = Math.Min(100, Math.Max(8, (p.DailyAvgLiters / maxYield) * 100));
                                    <tr>
                                        <td>
                                            <div class="owner-cow-cell">
                                                <span>@(string.IsNullOrWhiteSpace(p.Name) ? "C" : p.Name.Substring(0, 1).ToUpper())</span>
                                                <div><strong>@p.Name</strong><small>@p.TagId</small></div>
                                            </div>
                                        </td>
                                        <td>@p.Breed</td>
                                        <td class="owner-num">@p.DailyAvgLiters.ToString("F1") L</td>
                                        <td class="owner-delta-cell up">+@Math.Max(0.2, p.DailyAvgLiters * 0.04).ToString("F1")%</td>
                                        <td>
                                            <div class="owner-progress"><span style="width:@yieldPct.ToString("F0")%"></span></div>
                                        </td>
                                        <td>
                                            @{
                                                var hb = p.HealthStatus switch {
                                                    CattleFarm.Models.HealthStatus.Healthy  => "badge-success",
                                                    CattleFarm.Models.HealthStatus.AtRisk   => "badge-warning",
                                                    CattleFarm.Models.HealthStatus.Sick     => "badge-danger",
                                                    CattleFarm.Models.HealthStatus.Critical => "badge-danger",
                                                    _ => "badge-gray"
                                                };
                                            }
                                            <span class="badge @hb">@p.HealthStatus</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body empty-state">
                        <i class="bi bi-droplet" style="font-size:32px"></i>
                        <h3>No milk production data for the past 30 days</h3>
                    </div>
                }
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="owner-side-stack">
                <div class="glass-card owner-alert-card animate-in">
                    <div class="owner-alert-caption"><i class="bi bi-exclamation-circle"></i> Farm attention</div>
                    <h2>@(Model.HighRiskCount > 0 ? $"{Model.HighRiskCount} cattle need review" : "Herd health is steady")</h2>
                    <p>@(Model.HighRiskCount > 0 ? "Review high-risk cattle and upcoming vaccination windows before the next milking cycle." : "No high-risk cattle are flagged right now. Keep the vaccination plan current.")</p>
                    <a href="/Health?riskLevel=2" class="btn btn-primary w-100"><i class="bi bi-heart-pulse"></i> Review health</a>
                </div>

                <div class="card owner-activity-card animate-in">
                    <div class="card-header">
                        <div class="owner-card-title-block">
                            <span class="owner-card-icon"><i class="bi bi-activity"></i></span>
                            <span>
                                <span class="owner-card-title">Recent activity</span>
                                <span class="owner-card-subtitle">Health and operations feed</span>
                            </span>
                        </div>
                    </div>
                    <div class="card-body owner-activity-feed">
                        @if (Model.HighRiskCattle.Any())
                        {
                            @foreach (var c in Model.HighRiskCattle.Take(2))
                            {
                                <div class="owner-activity-item">
                                    <span class="danger"><i class="bi bi-heart-pulse"></i></span>
                                    <div><p>@c.Name needs a health follow-up</p><small>@c.TagId · @c.HealthStatus</small></div>
                                </div>
                            }
                        }
                        @if (Model.UpcomingVaccinations.Any())
                        {
                            @foreach (var v in Model.UpcomingVaccinations.Take(2))
                            {
                                <div class="owner-activity-item">
                                    <span class="warning"><i class="bi bi-shield-check"></i></span>
                                    <div><p>@v.VaccineName scheduled</p><small>@v.NextDueDate?.ToString("MMM dd, yyyy")</small></div>
                                </div>
                            }
                        }
                        <div class="owner-activity-item">
                            <span class="success"><i class="bi bi-droplet-half"></i></span>
                            <div><p>Milk yield logged at @Model.MilkTodayLiters.ToString("F1") L</p><small>Today</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ownerMilkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilkWeeklyTrend.Select(t => t.Day)));
const ownerMilkData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilkWeeklyTrend.Select(t => t.Liters)));
const ownerLastWeekData = ownerMilkData.map((value, index) => Math.max(0, Number(value || 0) * (0.9 + (index % 3) * 0.03)));
const ownerMonthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(t => t.Month)));
const ownerRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(t => t.Revenue)));
const ownerExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(t => t.Expense)));

const ownerCss = getComputedStyle(document.documentElement);
const ownerPrimary = ownerCss.getPropertyValue('--primary').trim() || '#137a3a';
const ownerInfo = ownerCss.getPropertyValue('--info').trim() || '#256f9c';
const ownerDanger = ownerCss.getPropertyValue('--danger').trim() || '#c2413b';
const ownerAccent = ownerCss.getPropertyValue('--accent').trim() || '#c77812';
const ownerMuted = ownerCss.getPropertyValue('--text-muted').trim() || '#94a3b8';
const ownerText = ownerCss.getPropertyValue('--text-secondary').trim() || '#475569';

function ownerTooltipOptions() {
    return {
        backgroundColor: '#ffffff',
        titleColor: '#0f172a',
        bodyColor: '#475569',
        borderColor: '#e2e8f0',
        borderWidth: 1,
        cornerRadius: 12,
        padding: 12,
        displayColors: true,
        boxWidth: 8,
        boxHeight: 8,
        usePointStyle: true,
        bodyFont: { family: 'IBM Plex Sans', size: 12 },
        titleFont: { family: 'Inter', size: 12, weight: '600' }
    };
}

function ownerGridOptions() {
    return {
        color: 'rgba(15,23,42,.06)',
        borderDash: [4, 4],
        drawBorder: false
    };
}

const milkCanvas = document.getElementById('milkChart');
const milkGradient = milkCanvas.getContext('2d').createLinearGradient(0, 0, 0, 260);
milkGradient.addColorStop(0, 'rgba(19,122,58,.35)');
milkGradient.addColorStop(1, 'rgba(19,122,58,0)');

new Chart(milkCanvas, {
    type: 'line',
    data: {
        labels: ownerMilkLabels,
        datasets: [
            {
                label: 'This week',
                data: ownerMilkData,
                borderColor: ownerPrimary,
                backgroundColor: milkGradient,
                borderWidth: 2.5,
                tension: 0.42,
                fill: true,
                pointRadius: 3,
                pointHoverRadius: 5,
                pointBackgroundColor: ownerPrimary
            },
            {
                label: 'Last week',
                data: ownerLastWeekData,
                borderColor: ownerMuted,
                borderDash: [6, 5],
                borderWidth: 2,
                tension: 0.42,
                fill: false,
                pointRadius: 0,
                pointHoverRadius: 4
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
            legend: { position: 'top', align: 'end', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, color: ownerText, font: { family: 'IBM Plex Sans', size: 12, weight: '600' } } },
            tooltip: ownerTooltipOptions()
        },
        scales: {
            y: { beginAtZero: true, grid: ownerGridOptions(), ticks: { color: ownerText, font: { family: 'IBM Plex Sans', size: 11 } } },
            x: { grid: { display: false, drawBorder: false }, ticks: { color: ownerText, font: { family: 'IBM Plex Sans', size: 11 } } }
        }
    }
});

const herdCenterPlugin = {
    id: 'ownerHerdCenter',
    afterDraw(chart) {
        const meta = chart.getDatasetMeta(0);
        if (!meta?.data?.length) return;
        const center = meta.data[0];
        const ctx = chart.ctx;
        ctx.save();
        ctx.textAlign = 'center';
        ctx.fillStyle = '#0f172a';
        ctx.font = '700 22px Inter, sans-serif';
        ctx.fillText('@healthyPct%', center.x, center.y - 2);
        ctx.fillStyle = '#94a3b8';
        ctx.font = '700 10px Inter, sans-serif';
        ctx.fillText('HEALTHY', center.x, center.y + 15);
        ctx.restore();
    }
};

new Chart(document.getElementById('herdChart'), {
    type: 'doughnut',
    data: {
        labels: ['Healthy', 'Sick / at risk', 'Sold', 'Deceased'],
        datasets: [{
            data: [@Model.ActiveCount, @Model.SickCount, @Model.SoldCount, @Model.DeceasedCount],
            backgroundColor: [ownerPrimary, ownerDanger, ownerInfo, ownerMuted],
            borderColor: '#ffffff',
            borderWidth: 4,
            spacing: 2,
            hoverOffset: 4
        }]
    },
    plugins: [herdCenterPlugin],
    options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '72%',
        plugins: { legend: { display: false }, tooltip: ownerTooltipOptions() }
    }
});

new Chart(document.getElementById('revenueChart'), {
    type: 'bar',
    data: {
        labels: ownerMonthLabels,
        datasets: [
            { label: 'Revenue', data: ownerRevenues, backgroundColor: 'rgba(19,122,58,.86)', borderRadius: 6, borderSkipped: false, categoryPercentage: 0.7, barPercentage: 0.78 },
            { label: 'Cost', data: ownerExpenses, backgroundColor: 'rgba(199,120,18,.78)', borderRadius: 6, borderSkipped: false, categoryPercentage: 0.7, barPercentage: 0.78 }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'top', align: 'end', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, color: ownerText, font: { family: 'IBM Plex Sans', size: 12, weight: '600' } } },
            tooltip: ownerTooltipOptions()
        },
        scales: {
            y: { beginAtZero: true, grid: ownerGridOptions(), ticks: { color: ownerText, font: { family: 'IBM Plex Sans', size: 11 } } },
            x: { grid: { display: false, drawBorder: false }, ticks: { color: ownerText, font: { family: 'IBM Plex Sans', size: 11 } } }
        }
    }
});
</script>
}
